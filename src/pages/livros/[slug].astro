---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const livros = await getCollection("livros");

  return livros.map((livro) => ({
    params: {
      slug: livro.id,
    },
    props: {
      livro,
    },
  }));
}

const { livro } = Astro.props;

const { Content } = await render(livro);

const score = livro.data.score ?? 0;

const aplicabilidade =
  livro.data.aplicabilidade ?? "Não avaliada";

const relevancia =
  livro.data.relevancia ?? "Não avaliada";

const atualidade =
  livro.data.atualidade ?? "Não avaliada";
---

<BaseLayout
  title={`${livro.data.title} | EstratégiaZ`}
  description={`Análise EstratégiaZ do livro ${livro.data.title}.`}
>

  <main class="container livro-page">


    <!-- =====================================================
         CABEÇALHO
         ===================================================== -->

    <div class="livro-header">


      <!-- INFORMAÇÕES DO LIVRO -->

      <div class="livro-main">

        <h1>
          {livro.data.title}
        </h1>

        <div class="livro-info">

          {livro.data.autor && (
            <p>
              <strong>Autor:</strong>
              {livro.data.autor}
            </p>
          )}

          {livro.data.ano && (
            <p>
              <strong>Ano:</strong>
              {livro.data.ano}
            </p>
          )}

          {livro.data.editora && (
            <p>
              <strong>Editora:</strong>
              {livro.data.editora}
            </p>
          )}

        </div>

      </div>


      <!-- ESTRATEGIAZ SCORE -->

      <div class="score-card">

        <span class="score-label">
          ESTRATEGIAZ SCORE
        </span>

        <div class="score">

          {score.toFixed(1)}

          <span>
            /10
          </span>

        </div>

        <div class="score-stars">
          ★★★★★
        </div>

        <p>
          Avaliação editorial EstratégiaZ
        </p>

      </div>

    </div>


    <!-- =====================================================
         LAYOUT PRINCIPAL
         ===================================================== -->

    <div class="livro-layout">


      <!-- ===================================================
           CONTEÚDO PRINCIPAL
           =================================================== -->

      <main class="livro-primary">


        <!-- =================================================
             CONTEÚDO COMPLETO
             
             Fica escondido inicialmente e serve como fonte
             para gerar o resumo público.
             ================================================= -->

        <article
          id="livro-content-source"
          class="livro-content-source"
        >

          <Content />

        </article>


        <!-- =================================================
             RESUMO PÚBLICO
             ================================================= -->

        <div
          id="livro-public-summary"
          class="livro-public-summary"
        ></div>


        <!-- =================================================
             CTA NÍVEL 2
             ================================================= -->

        <div
          id="level-two-cta"
          class="level-two-cta"
        >

          <div class="level-two-cta-content">

            <span class="level-two-kicker">
              INTELIGÊNCIA ESTRATÉGICA
            </span>

            <h2>
              Quer conhecer mais sobre {livro.data.title}?
            </h2>

            <p>
              Acesse a análise ampliada e participe
              como avaliador da comunidade EstratégiaZ.
            </p>

            <a
              href={`/login?redirect=/livros/${livro.id}`}
              class="level-two-button"
            >
              Conheça mais
            </a>

          </div>

        </div>


        <!-- =================================================
             NÍVEL 2
             ================================================= -->

        <div
          id="level-two-content"
          class="level-two-content"
          hidden
        >


          <!-- ===============================================
               AVALIAÇÕES EDITORIAIS
               =============================================== -->

          <div class="rating-grid">


            <div class="rating-item">

              <span>
                Aplicabilidade
              </span>

              <strong>
                {aplicabilidade}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Relevância
              </span>

              <strong>
                {relevancia}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Atualidade
              </span>

              <strong>
                {atualidade}
              </strong>

            </div>


          </div>


          <!-- ===============================================
               CONTEÚDO COMPLETO DO OBSIDIAN
               =============================================== -->

          <article class="livro-content">

            <Content />

          </article>

        </div>

      </main>


      <!-- ===================================================
           COMUNIDADE
           =================================================== -->

      <aside class="livro-sidebar">


        <section
          class="community-rating"
          id="rating-area"
        >


          <!-- CABEÇALHO -->

          <div class="community-heading">

            <span class="community-eyebrow">
              AVALIAÇÃO DA COMUNIDADE
            </span>

            <h2>
              O que você acha deste livro?
            </h2>

            <p>
              Avalie este livro e compartilhe
              sua experiência com outros profissionais.
            </p>

          </div>


          <!-- MÉDIA -->

          <div
            class="community-result"
            id="community-result"
          >

            <div
              id="community-average-stars"
              class="community-average-stars"
            >
              ☆☆☆☆☆
            </div>

            <div class="community-average-info">

              <strong id="community-average">
                —
              </strong>

              <span>
                /5
              </span>

            </div>

            <p id="community-count">
              Ainda não há avaliações.
            </p>

          </div>


          <!-- ESTRELAS DA COMUNIDADE -->

          <div
            id="rating-stars"
            data-conteudo-id={livro.id}
            class="rating-stars"
          >

            <button
              type="button"
              data-rating="1"
              aria-label="Avaliar com 1 estrela"
            >
              ★
            </button>

            <button
              type="button"
              data-rating="2"
              aria-label="Avaliar com 2 estrelas"
            >
              ★
            </button>

            <button
              type="button"
              data-rating="3"
              aria-label="Avaliar com 3 estrelas"
            >
              ★
            </button>

            <button
              type="button"
              data-rating="4"
              aria-label="Avaliar com 4 estrelas"
            >
              ★
            </button>

            <button
              type="button"
              data-rating="5"
              aria-label="Avaliar com 5 estrelas"
            >
              ★
            </button>

          </div>


          <p
            id="rating-hint"
            class="rating-hint"
          >
            Selecione uma nota de 1 a 5.
          </p>


          <div
            id="rating-message"
            class="rating-message"
            aria-live="polite"
          ></div>


          <!-- =================================================
               AVALIAÇÃO DO AVALIADOR
               ================================================= -->

          <div
            id="evaluator-area"
            class="evaluator-area"
            hidden
          >

            <div class="evaluator-heading">

              <span class="community-eyebrow">
                AVALIAÇÃO DO AVALIADOR
              </span>

              <h3>
                Avalie este livro
              </h3>

              <p>
                Sua avaliação ajuda a construir
                a inteligência coletiva do EstratégiaZ.
              </p>

            </div>


            <div class="criterion-rating">


              <!-- APLICABILIDADE -->

              <div class="criterion-item">

                <div class="criterion-label">

                  <strong>
                    Aplicabilidade
                  </strong>

                  <span>
                    É útil para situações reais?
                  </span>

                </div>

                <div
                  class="criterion-stars"
                  data-criterion="aplicabilidade"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>


              <!-- RELEVÂNCIA -->

              <div class="criterion-item">

                <div class="criterion-label">

                  <strong>
                    Relevância
                  </strong>

                  <span>
                    O conhecimento continua relevante?
                  </span>

                </div>

                <div
                  class="criterion-stars"
                  data-criterion="relevancia"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>


              <!-- ATUALIDADE -->

              <div class="criterion-item">

                <div class="criterion-label">

                  <strong>
                    Atualidade
                  </strong>

                  <span>
                    Continua atual para os negócios?
                  </span>

                </div>

                <div
                  class="criterion-stars"
                  data-criterion="atualidade"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>


            </div>


            <!-- BOTÃO -->

            <button
              type="button"
              id="evaluator-submit"
              class="evaluator-submit"
            >
              Salvar minha avaliação
            </button>


            <p
              id="evaluator-message"
              class="evaluator-message"
              aria-live="polite"
            ></p>

          </div>


          <!-- =================================================
               COMENTÁRIO
               ================================================= -->

          <div
            id="comment-area"
            class="comment-area"
            hidden
          >

            <div class="review-user">

              <div
                class="review-avatar"
                id="review-avatar"
              >
                E
              </div>

              <div class="review-user-info">

                <strong id="review-user-name">
                  Avaliando como você
                </strong>

                <span>
                  Sua opinião ajuda a comunidade EstratégiaZ.
                </span>

              </div>

            </div>


            <label for="comentario">
              Compartilhe sua opinião
            </label>


            <textarea
              id="comentario"
              maxlength="1000"
              placeholder="O que você acha deste livro? Conte sua experiência, aplicação prática ou principal aprendizado..."
            ></textarea>


            <div class="comment-footer">

              <span id="comment-counter">
                0/1000
              </span>

              <button
                type="button"
                id="comment-button"
              >
                Publicar comentário
              </button>

            </div>

          </div>


        </section>

      </aside>

    </div>

  </main>

</BaseLayout>


<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

  import { supabase } from "../../lib/supabase.js";


  /*
   * ELEMENTOS
   */

  const stars =
    document.querySelectorAll<HTMLButtonElement>(
      "#rating-stars button"
    );


  const ratingContainer =
    document.querySelector(
      "#rating-stars"
    );


  const averageStars =
    document.querySelector<HTMLElement>(
      "#community-average-stars"
    );


  const average =
    document.querySelector<HTMLElement>(
      "#community-average"
    );


  const count =
    document.querySelector<HTMLElement>(
      "#community-count"
    );


  const hint =
    document.querySelector(
      "#rating-hint"
    );


  const message =
    document.querySelector(
      "#rating-message"
    );


  const evaluatorArea =
    document.querySelector(
      "#evaluator-area"
    );


  const evaluatorSubmit =
    document.querySelector(
      "#evaluator-submit"
    );


  const evaluatorMessage =
    document.querySelector(
      "#evaluator-message"
    );


  const commentArea =
    document.querySelector(
      "#comment-area"
    );


  const commentInput =
    document.querySelector(
      "#comentario"
    );


  const commentButton =
    document.querySelector(
      "#comment-button"
    );


  const commentCounter =
    document.querySelector(
      "#comment-counter"
    );


  const userName =
    document.querySelector(
      "#review-user-name"
    );


  const avatar =
    document.querySelector(
      "#review-avatar"
    );


  const publicSummary =
    document.querySelector(
      "#livro-public-summary"
    );


  const contentSource =
    document.querySelector(
      "#livro-content-source"
    );


  const levelTwoContent =
    document.querySelector(
      "#level-two-content"
    );


  const levelTwoCta =
    document.querySelector(
      "#level-two-cta"
    );


  /*
   * VERIFICA ELEMENTOS ESSENCIAIS
   */

  if (
    !(ratingContainer instanceof HTMLElement) ||
    !(hint instanceof HTMLElement) ||
    !(message instanceof HTMLElement)
  ) {

    throw new Error(
      "Elementos da avaliação do livro não encontrados."
    );

  }


  const conteudoTipo =
    "livro";


  const conteudoId =
    ratingContainer.dataset.conteudoId;


  if (!conteudoId) {

    throw new Error(
      "ID do livro não encontrado."
    );

  }


  /*
   * =========================================================
   * RESUMO PÚBLICO
   * =========================================================
   */

  function montarResumoPublico() {

    if (
      !(publicSummary instanceof HTMLElement) ||
      !(contentSource instanceof HTMLElement)
    ) {

      return;

    }


    const elementos =
      Array.from(
        contentSource.children
      );


    let secaoAtual = 0;

    let capturando = false;


    elementos.forEach(
      (elemento) => {

        const tag =
          elemento.tagName.toLowerCase();


        /*
         * O resumo público do livro é formado pelas
         * duas primeiras seções do Markdown:
         *
         * ## Por que este livro importa
         * ## Principais ideias
         */

        if (tag === "h2") {

          secaoAtual++;

          capturando =
            secaoAtual <= 2;

        }


        if (capturando) {

          publicSummary.appendChild(
            elemento.cloneNode(true)
          );

        }

      }
    );

  }


  /*
   * =========================================================
   * NÍVEL 2
   * =========================================================
   */

  async function verificarNivelDoUsuario() {

    const {
      data: {
        user
      }
    } =
      await supabase.auth.getUser();


    if (!user) {

      return;

    }


    /*
     * Usuário logado:
     * libera o conteúdo completo.
     */

    if (
      levelTwoContent instanceof HTMLElement
    ) {

      levelTwoContent.hidden =
        false;

    }


    if (
      levelTwoCta instanceof HTMLElement
    ) {

      levelTwoCta.hidden =
        true;

    }


    if (
      publicSummary instanceof HTMLElement
    ) {

      publicSummary.hidden =
        true;

    }


    if (
      contentSource instanceof HTMLElement
    ) {

      contentSource.hidden =
        true;

    }


    /*
     * Preenche nome do avaliador
     */

    const nome =
      user.user_metadata?.full_name ||
      user.user_metadata?.name ||
      user.email?.split("@")[0] ||
      "Avaliador";


    if (
      userName instanceof HTMLElement
    ) {

      userName.textContent =
        nome;

    }


    if (
      avatar instanceof HTMLElement
    ) {

      avatar.textContent =
        nome
          .charAt(0)
          .toUpperCase();

    }

  }


  /*
   * =========================================================
   * MÉDIA DA COMUNIDADE
   * =========================================================
   */

  async function carregarMediaComunidade() {

    const {
      data,
      error
    } =
      await supabase
        .from("avaliacoes")
        .select("nota")
        .eq(
          "conteudo_tipo",
          conteudoTipo
        )
        .eq(
          "conteudo_id",
          conteudoId
        );


    if (error) {

      console.error(
        "Erro ao carregar avaliações:",
        error
      );


      if (
        average instanceof HTMLElement
      ) {

        average.textContent =
          "—";

      }


      if (
        count instanceof HTMLElement
      ) {

        count.textContent =
          "Não foi possível carregar as avaliações.";

      }


      if (
        averageStars instanceof HTMLElement
      ) {

        averageStars.textContent =
          "☆☆☆☆☆";

      }


      return;

    }


    if (
      !data ||
      data.length === 0
    ) {

      if (
        average instanceof HTMLElement
      ) {

        average.textContent =
          "—";

      }


      if (
        count instanceof HTMLElement
      ) {

        count.textContent =
          "Ainda não há avaliações.";

      }


      if (
        averageStars instanceof HTMLElement
      ) {

        averageStars.textContent =
          "☆☆☆☆☆";

      }


      return;

    }


    const quantidade =
      data.length;


    const soma =
      data.reduce(
        (
          total: number,
          avaliacao: { nota: number }
        ) =>
          total +
          Number(
            avaliacao.nota
          ),
        0
      );


    const media =
      soma / quantidade;


    if (
      average instanceof HTMLElement
    ) {

      average.textContent =
        media.toFixed(1);

    }


    if (
      count instanceof HTMLElement
    ) {

      count.textContent =
        quantidade === 1
          ? "1 avaliação da comunidade."
          : `${quantidade} avaliações da comunidade.`;

    }


    const estrelasCheias =
      Math.round(media);


    let estrelas =
      "";


    for (
      let i = 1;
      i <= 5;
      i++
    ) {

      estrelas +=
        i <= estrelasCheias
          ? "★"
          : "☆";

    }


    if (
      averageStars instanceof HTMLElement
    ) {

      averageStars.textContent =
        estrelas;

    }

  }


  /*
   * =========================================================
   * ESTRELAS DA COMUNIDADE
   * =========================================================
   */

  stars.forEach(
    (star) => {

      star.addEventListener(
        "click",
        async () => {

          const nota =
            Number(
              star.dataset.rating
            );


          /*
           * Verifica login
           */

          const {
            data: {
              user
            }
          } =
            await supabase.auth.getUser();


          /*
           * Se não estiver logado,
           * envia para cadastro.
           */

          if (!user) {

            window.location.href =
              `/cadastro?redirect=/livros/${conteudoId}`;

            return;

          }


          /*
           * Desabilita enquanto salva
           */

          stars.forEach(
            (button) => {

              button.disabled =
                true;

            }
          );


          message.textContent =
            "Registrando sua avaliação...";


          /*
           * Salva avaliação geral
           */

          const {
            error
          } =
            await supabase
              .from("avaliacoes")
              .insert({

                user_id:
                  user.id,

                conteudo_tipo:
                  conteudoTipo,

                conteudo_id:
                  conteudoId,

                nota,

                publicado:
                  false

              });


          if (error) {

            console.error(
              "Erro Supabase:",
              error
            );


            message.textContent =
              `Erro ao registrar: ${error.message}`;


            stars.forEach(
              (button) => {

                button.disabled =
                  false;

              }
            );


            return;

          }


          /*
           * Marca estrelas escolhidas
           */

          stars.forEach(
            (button) => {

              const rating =
                Number(
                  button.dataset.rating
                );


              button.classList.toggle(
                "selected",
                rating <= nota
              );

            }
          );


          hint.textContent =
            "Você já avaliou este livro.";


          message.textContent =
            `Sua avaliação: ${nota}/5`;


          /*
           * Libera avaliação dos critérios
           */

          if (
            evaluatorArea instanceof HTMLElement
          ) {

            evaluatorArea.hidden =
              false;

          }

        }
      );

    }
  );


  /*
   * =========================================================
   * ESTRELAS DOS CRITÉRIOS
   * =========================================================
   */

  const criterionStars =
    document.querySelectorAll<HTMLElement>(
      ".criterion-stars"
    );


  const criterios: Record<
    string,
    number
  > = {};


  criterionStars.forEach(
    (grupo) => {

      const criterio =
        grupo.dataset.criterion;


      if (!criterio) {

        return;

      }


      const botoes =
        grupo.querySelectorAll<HTMLButtonElement>(
          "button"
        );


      botoes.forEach(
        (botao) => {

          botao.addEventListener(
            "click",
            () => {

              const valor =
                Number(
                  botao.dataset.value
                );


              criterios[criterio] =
                valor;


              botoes.forEach(
                (item) => {

                  const itemValor =
                    Number(
                      item.dataset.value
                    );


                  item.classList.toggle(
                    "selected",
                    itemValor <= valor
                  );

                }
              );

            }
          );

        }
      );

    }
  );


  /*
   * =========================================================
   * SALVAR AVALIAÇÃO DO AVALIADOR
   * =========================================================
   */

  if (
    evaluatorSubmit instanceof HTMLButtonElement
  ) {

    evaluatorSubmit.addEventListener(
      "click",
      async () => {

        const {
          data: {
            user
          }
        } =
          await supabase.auth.getUser();


        if (!user) {

          window.location.href =
            `/cadastro?redirect=/livros/${conteudoId}`;

          return;

        }


        /*
         * Verifica se os três critérios foram avaliados
         */

        if (
          !criterios.aplicabilidade ||
          !criterios.relevancia ||
          !criterios.atualidade
        ) {

          if (
            evaluatorMessage instanceof HTMLElement
          ) {

            evaluatorMessage.textContent =
              "Avalie os três critérios antes de salvar.";

          }

          return;

        }


        evaluatorSubmit.disabled =
          true;


        if (
          evaluatorMessage instanceof HTMLElement
        ) {

          evaluatorMessage.textContent =
            "Salvando sua avaliação...";

        }


        /*
         * Atualiza a avaliação geral existente
         */

        const {
          error
        } =
          await supabase
            .from("avaliacoes")
            .update({

              aplicabilidade:
                criterios.aplicabilidade,

              relevancia:
                criterios.relevancia,

              atualidade:
                criterios.atualidade

            })
            .eq(
              "user_id",
              user.id
            )
            .eq(
              "conteudo_tipo",
              conteudoTipo
            )
            .eq(
              "conteudo_id",
              conteudoId
            );


        if (error) {

          console.error(
            "Erro ao salvar critérios:",
            error
          );


          if (
            evaluatorMessage instanceof HTMLElement
          ) {

            evaluatorMessage.textContent =
              `Erro ao salvar: ${error.message}`;

          }


          evaluatorSubmit.disabled =
            false;


          return;

        }


        if (
          evaluatorMessage instanceof HTMLElement
        ) {

          evaluatorMessage.textContent =
            "Sua avaliação foi salva com sucesso.";

        }


        evaluatorSubmit.textContent =
          "Avaliação salva";


        /*
         * Mostra área de comentário
         */

        if (
          commentArea instanceof HTMLElement
        ) {

          commentArea.hidden =
            false;

        }

      }
    );

  }


  /*
   * =========================================================
   * CONTADOR DO COMENTÁRIO
   * =========================================================
   */

  if (
    commentInput instanceof HTMLTextAreaElement &&
    commentCounter instanceof HTMLElement
  ) {

    commentInput.addEventListener(
      "input",
      () => {

        commentCounter.textContent =
          `${commentInput.value.length}/1000`;

      }
    );

  }


  /*
   * =========================================================
   * PUBLICAR COMENTÁRIO
   * =========================================================
   */

  if (
    commentButton instanceof HTMLButtonElement
  ) {

    commentButton.addEventListener(
      "click",
      async () => {

        const {
          data: {
            user
          }
        } =
          await supabase.auth.getUser();


        if (!user) {

          window.location.href =
            `/cadastro?redirect=/livros/${conteudoId}`;

          return;

        }


        if (
          !(commentInput instanceof HTMLTextAreaElement)
        ) {

          return;

        }


        const comentario =
          commentInput.value.trim();


        if (!comentario) {

          commentInput.focus();

          return;

        }


        commentButton.disabled =
          true;


        commentButton.textContent =
          "Publicando...";


        const {
          error
        } =
          await supabase
            .from("avaliacoes")
            .update({

              comentario,

              depoimento:
                comentario,

              publicado:
                true

            })
            .eq(
              "user_id",
              user.id
            )
            .eq(
              "conteudo_tipo",
              conteudoTipo
            )
            .eq(
              "conteudo_id",
              conteudoId
            );


        if (error) {

          console.error(
            "Erro ao publicar comentário:",
            error
          );


          commentButton.disabled =
            false;

          commentButton.textContent =
            "Publicar comentário";

          return;

        }


        commentButton.textContent =
          "Comentário publicado";

        commentInput.disabled =
          true;

      }
    );

  }


  /*
   * =========================================================
   * INICIALIZAÇÃO
   * ========================================================= */

  montarResumoPublico();

  verificarNivelDoUsuario();

  carregarMediaComunidade();

</script>


