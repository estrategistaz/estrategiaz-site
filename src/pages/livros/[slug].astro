---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const livros = await getCollection("livros");

    return livros.map((livro) => ({
        params: {
            slug: livro.id,
        },
        props: {
            livro,
        },
    }));
}

const { livro } = Astro.props;
const { Content } = await render(livro);
---

<BaseLayout
    title={`${livro.data.title} | EstratégiaZ`}
    description={`Análise EstratégiaZ do livro ${livro.data.title}.`}
>

    <article class="content">

        <header>

            <span>📚 Livro</span>

            <h1>{livro.data.title}</h1>

            {livro.data.autor && (
                <p>
                    <strong>Autor:</strong> {livro.data.autor}
                </p>
            )}

            {livro.data.ano && (
                <p>
                    <strong>Ano:</strong> {livro.data.ano}
                </p>
            )}

            {livro.data.editora && (
                <p>
                    <strong>Editora:</strong> {livro.data.editora}
                </p>
            )}

            {livro.data.score !== undefined && (
                <div class="score">
                    ⭐ EstratégiaZ: {livro.data.score}/10
                </div>
            )}

            {livro.data.relevancia && (
                <p>
                    <strong>Relevância:</strong> {livro.data.relevancia}
                </p>
            )}

            {livro.data.aplicabilidade && (
                <p>
                    <strong>Aplicabilidade:</strong> {livro.data.aplicabilidade}
                </p>
            )}

            {livro.data.atualidade && (
                <p>
                    <strong>Atualidade:</strong> {livro.data.atualidade}
                </p>
            )}

        </header>

        <hr />

        <Content />

    </article>

</BaseLayout>