---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const livros = await getCollection("livros");
---

<BaseLayout
    title="Livros | EstratégiaZ"
    description="Livros fundamentais para estratégia, gestão, liderança e negócios."
>

    <h1>Biblioteca Estratégica</h1>

    <p>
        Livros fundamentais para estratégia, gestão, liderança e negócios.
    </p>

    <div class="grid">

        {livros.map((livro) => (

            <a
                class="card"
                href={`/livros/${livro.id}`}
            >

                <h2>{livro.data.title}</h2>

                {livro.data.autor && (
                    <p>
                        <strong>Autor:</strong> {livro.data.autor}
                    </p>
                )}

                {livro.data.ano && (
                    <p>
                        <strong>Ano:</strong> {livro.data.ano}
                    </p>
                )}

                {livro.data.editora && (
                    <p>
                        <strong>Editora:</strong> {livro.data.editora}
                    </p>
                )}

                {livro.data.score !== undefined && (
                    <p>
                        ⭐ <strong>EstratégiaZ:</strong> {livro.data.score}/10
                    </p>
                )}

                {livro.data.aplicabilidade && (
                    <p>
                        <strong>Aplicabilidade:</strong> {livro.data.aplicabilidade}
                    </p>
                )}

            </a>

        ))}

    </div>

</BaseLayout>