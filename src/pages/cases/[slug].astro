---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import CaseVoting from "../../components/CaseVoting.astro";

export async function getStaticPaths() {
    const cases = await getCollection("cases");

    return cases.map((caso) => ({
        params: {
            slug: caso.id,
        },
        props: {
            caso,
        },
    }));
}

const { caso } = Astro.props;

const { Content } = await render(caso);

const autores = caso.data.autores ?? [];
const livros = caso.data.livros ?? [];
const frameworks = caso.data.frameworks ?? [];
const tags = caso.data.tags ?? [];
const problema = caso.data.problema ?? [];

const caseDescription =
    `Análise do case ${caso.data.title}` +
    (caso.data.empresa
        ? ` da empresa ${caso.data.empresa}`
        : "") +
    (caso.data.setor
        ? ` no setor de ${caso.data.setor}`
        : "") +
    `, com foco em estratégia empresarial.`;

const caseSchema = {
    "@context": "https://schema.org",
    "@type": "Article",

    "headline": caso.data.title,

    "url": `https://estrategiaz.com/cases/${caso.id}`,

    "description": caseDescription,

    "publisher": {
        "@type": "Organization",
        "name": "EstratégiaZ",
        "url": "https://estrategiaz.com"
    },

    ...(caso.data.empresa && {
        "about": {
            "@type": "Organization",
            "name": caso.data.empresa
        }
    }),

    ...(caso.data.pais && {
        "contentLocation": {
            "@type": "Country",
            "name": caso.data.pais
        }
    }),

    ...(caso.data.setor && {
        "articleSection": caso.data.setor
    }),

    ...(tags.length > 0 && {
        "keywords": tags.join(", ")
    })
};
---

<BaseLayout
    title={`${caso.data.title} | Case Estratégico | EstratégiaZ`}
    description={caseDescription}
    canonical={`https://estrategiaz.com/cases/${caso.id}`}
    ogType="article"
    schema={caseSchema}
>

<div class="case-page">

    <!-- =====================================================
         NÍVEL 1
         CONTEÚDO PÚBLICO
         ===================================================== -->

    <section class="case-header">

        <div class="case-information">

            <span class="case-kicker">
                CASE ESTRATÉGICO
            </span>
                {caso.data.logo && (
            <div class="case-logo">
                <img
                    src={caso.data.logo}
                    alt={`Logo da empresa ${caso.data.empresa ?? ""}`}
                />
            </div>
        )}
            <h1>
                {caso.data.title}
            </h1>

            {caso.data.empresa && (
                <p>
                    <strong>Empresa:</strong>
                    {caso.data.empresa}
                </p>
            )}

            {caso.data.setor && (
                <p>
                    <strong>Setor:</strong>
                    {caso.data.setor}
                </p>
            )}

            {caso.data.pais && (
                <p>
                    <strong>País:</strong>
                    {caso.data.pais}
                </p>
            )}

        </div>


        <!-- SCORE -->

        <div class="score-card">

            <span class="score-label">
                ESTRATEGIAZ SCORE
            </span>

            <div class="score">
                9.5
                <span>/10</span>
            </div>

            <div class="score-stars">
                ★★★★★
            </div>

            <p>
                Avaliação editorial EstratégiaZ
            </p>

        </div>

    </section>


    <!-- =====================================================
         PROBLEMA ESTRATÉGICO
         ===================================================== -->

    {problema.length > 0 && (

        <section class="case-problem">

            <span class="section-kicker">
                DESAFIO ESTRATÉGICO
            </span>

            <h2>
                Qual era o problema?
            </h2>

            <ul>

                {problema.map((item) => (
                    <li>{item}</li>
                ))}

            </ul>

        </section>

    )}


    <!-- =====================================================
         NÍVEL 2
         ÁREA PROTEGIDA
         ===================================================== -->

    <section class="level-two">

        <!-- CABEÇALHO DO NÍVEL 2 -->

        <div class="level-two-header">

            <span class="level-two-kicker">
                NÍVEL 2
            </span>

            <h2>
                Continue explorando este case
            </h2>

            <p>
                A análise completa conecta este case a autores,
                livros, frameworks e outros casos estratégicos.
            </p>

            

        </div>


        <!-- =================================================
             BLOQUEIO
             ================================================= -->

        <div
            class="login-required"
            id="login-required"
        >

            <div class="lock-icon">
                🔒
            </div>

            <h3>
                Conteúdo reservado
            </h3>

            <p>
                Entre na sua conta para acessar
                a análise completa deste case.
            </p>

            <a
                href={`/login?redirect=/cases/${caso.id}`}
                class="primary-button"
            >
                Entrar para continuar
            </a>

        </div>


        <!-- =================================================
     CONTEÚDO PROTEGIDO + AVALIAÇÃO
     ================================================= -->

<div
    class="protected-area"
    id="protected-area"
    hidden
>

    <div class="case-analysis-layout">

        <!-- =========================
             CONTEÚDO DO CASE
             ========================= -->

        <article class="case-content">

            <Content />

        </article>


        <!-- =========================
             SIDEBAR DE AVALIAÇÃO
             ========================= -->

        <aside class="case-sidebar">

            <CaseVoting
                caseSlug={caso.id}
                mode="protected"
            />

        </aside>

    </div>

</div>

            <!-- =================================================
                 CONEXÕES ESTRATÉGICAS
                 ================================================= -->

            <section class="related-content">

                <span class="section-kicker">
                    CONEXÕES ESTRATÉGICAS
                </span>

                <h2>
                    Este case se relaciona com
                </h2>


                {autores.length > 0 && (

                    <div class="related-group">

                        <h3>
                            Autores
                        </h3>

                        <div class="related-list">

                            {autores.map((autor) => (
                                <span class="related-tag">
                                    {autor}
                                </span>
                            ))}

                        </div>

                    </div>

                )}


                {livros.length > 0 && (

                    <div class="related-group">

                        <h3>
                            Livros
                        </h3>

                        <div class="related-list">

                            {livros.map((livro) => (
                                <span class="related-tag">
                                    {livro}
                                </span>
                            ))}

                        </div>

                    </div>

                )}


                {frameworks.length > 0 && (

                    <div class="related-group">

                        <h3>
                            Frameworks
                        </h3>

                        <div class="related-list">

                            {frameworks.map((framework) => (
                                <span class="related-tag">
                                    {framework}
                                </span>
                            ))}

                        </div>

                    </div>

                )}


                {tags.length > 0 && (

                    <div class="related-group">

                        <h3>
                            Temas
                        </h3>

                        <div class="related-list">

                            {tags.map((tag) => (
                                <span class="related-tag">
                                    #{tag}
                                </span>
                            ))}

                        </div>

                    </div>

                )}

            </section>


            <!-- =================================================
                 ESTRATEGIAZ PRO
                 ================================================= -->

            <section class="premium-preview">

                <span class="premium-kicker">
                    ESTRATEGIAZ PRO
                </span>

                <h2>
                    Quer explorar outros casos relacionados?
                </h2>

                <p>
                    Conecte casos, autores, livros e frameworks
                    para descobrir novas possibilidades estratégicas.
                </p>

                <a
                    href="/mesa"
                    class="pro-button"
                >
                    Explorar inteligência estratégica →
                </a>

            </section>

        

    </section>

</div>


<!-- =========================================================
     AUTENTICAÇÃO SUPABASE
     ========================================================= -->

<script>

    import { supabase } from "../../lib/supabase.js";


    const loginRequired =
        document.querySelector("#login-required");

    const protectedArea =
        document.querySelector("#protected-area");


    function showProtectedContent() {

        if (!(loginRequired instanceof HTMLElement)) {
            return;
        }

        if (!(protectedArea instanceof HTMLElement)) {
            return;
        }


        loginRequired.hidden = true;

        protectedArea.hidden = false;

    }


    function showLoginRequired() {

        if (!(loginRequired instanceof HTMLElement)) {
            return;
        }

        if (!(protectedArea instanceof HTMLElement)) {
            return;
        }


        loginRequired.hidden = false;

        protectedArea.hidden = true;

    }


    async function checkAuthentication() {

        const {
            data,
            error
        } = await supabase.auth.getSession();


        if (error) {

            console.error(
                "Erro ao verificar autenticação:",
                error
            );

            showLoginRequired();

            return;
        }


        if (data.session) {

            showProtectedContent();

        } else {

            showLoginRequired();

        }

    }


    /*
     * Verifica imediatamente
     * se existe uma sessão.
     */

    checkAuthentication();


    /*
     * Também acompanha mudanças
     * de login/logout.
     */

    supabase.auth.onAuthStateChange(
        (_event, session) => {

            if (session) {

                showProtectedContent();

            } else {

                showLoginRequired();

            }

        }
    );

</script>


<style>

/* =========================================================
   PÁGINA
   ========================================================= */

.case-page {

    max-width: 1200px;

    margin: 0 auto;

    padding: 50px 24px 80px;

}


/* =========================================================
   NÍVEL 1
   ========================================================= */

.case-header {

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        320px;

    gap: 50px;

    align-items: start;

}


.case-kicker,
.section-kicker,
.level-two-kicker,
.premium-kicker {

    display: block;

    margin-bottom: 12px;

    color: #2563eb;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: .16em;

}


.case-information h1 {

    margin: 0 0 30px;

    color: #0f172a;

    font-size: 52px;

    line-height: 1.08;

}


.case-information p {

    margin: 0 0 10px;

    color: #334155;

    font-size: 16px;

}


.case-information strong {

    color: #0f172a;

}


/* =========================================================
   SCORE
   ========================================================= */

.score-card {

    padding: 28px;

    background: white;

    border: 1px solid #dbe3ef;

    border-radius: 18px;

    box-shadow: 0 10px 25px rgba(15,23,42,.06);

    text-align: center;

}


.score-label {

    display: block;

    margin-bottom: 12px;

    color: #64748b;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .16em;

}


.score {

    color: #2563eb;

    font-size: 44px;

    font-weight: 800;

    line-height: 1;

}


.score span {

    color: #64748b;

    font-size: 18px;

    font-weight: 500;

}


.score-stars {

    margin-top: 12px;

    color: #f59e0b;

    font-size: 20px;

    letter-spacing: 2px;

}


.score-card p {

    margin: 14px 0 0;

    color: #64748b;

    font-size: 13px;

}


/* =========================================================
   PROBLEMA
   ========================================================= */

.case-problem {

    margin-top: 45px;

    padding: 30px;

    background: white;

    border: 1px solid #dbe3ef;

    border-radius: 18px;

}


.case-problem h2 {

    margin: 0 0 20px;

    color: #0f172a;

    font-size: 28px;

}


.case-problem ul {

    margin: 0;

    padding-left: 22px;

}


.case-problem li {

    margin-bottom: 10px;

    color: #334155;

    line-height: 1.6;

}


/* =========================================================
   NÍVEL 2
   ========================================================= */

.level-two {

    margin-top: 45px;

    padding: 40px;

    background: #eff6ff;

    border: 1px solid #cfe1ff;

    border-radius: 20px;

}


.level-two-header {

    max-width: 900px;

}


.level-two-header h2 {

    margin: 0 0 12px;

    color: #0f172a;

    font-size: 34px;

    line-height: 1.2;

}


.level-two-header p {

    margin: 0;

    color: #334155;

    font-size: 17px;

    line-height: 1.6;

}


/* =========================================================
   BOTÕES
   ========================================================= */

.level-two-actions {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 28px;

}


.primary-button,
.secondary-button,
.pro-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 48px;

    padding: 0 20px;

    border-radius: 10px;

    font-weight: 700;

    text-decoration: none;

    transition:
        transform .2s,
        box-shadow .2s,
        background .2s;

}


.primary-button {

    background: #2563eb;

    color: white;

}


.primary-button:hover {

    background: #1d4ed8;

    transform: translateY(-1px);

    box-shadow:
        0 8px 20px rgba(37,99,235,.22);

}


.secondary-button {

    background: white;

    color: #334155;

    border: 1px solid #cbd5e1;

}


.secondary-button:hover {

    background: #f8fafc;

}


/* =========================================================
   BLOQUEIO
   ========================================================= */

.login-required {

    margin-top: 34px;

    padding: 45px 30px;

    background: white;

    border: 1px solid #dbe3ef;

    border-radius: 16px;

    text-align: center;

}


.lock-icon {

    margin-bottom: 18px;

    font-size: 36px;

}


.login-required h3 {

    margin: 0 0 10px;

    color: #0f172a;

    font-size: 24px;

}


.login-required p {

    max-width: 560px;

    margin: 0 auto 24px;

    color: #64748b;

    font-size: 16px;

    line-height: 1.6;

}


/* =========================================================
   CONTEÚDO PROTEGIDO
   ========================================================= */

.protected-area {

    margin-top: 34px;

}


.case-content {

    padding: 34px;

    background: white;

    border: 1px solid #dbe3ef;

    border-radius: 16px;

}


.case-content h1,
.case-content h2,
.case-content h3 {

    color: #0f172a;

}


.case-content p {

    color: #334155;

    line-height: 1.75;

}


.case-content li {

    margin-bottom: 8px;

    line-height: 1.6;

}


/* =========================================================
   CONEXÕES
   ========================================================= */

.related-content {

    margin-top: 35px;

    padding: 30px;

    background: white;

    border: 1px solid #dbe3ef;

    border-radius: 16px;

}


.related-content h2 {

    margin: 0 0 28px;

    color: #0f172a;

    font-size: 28px;

}


.related-group {

    margin-bottom: 24px;

}


.related-group:last-child {

    margin-bottom: 0;

}


.related-group h3 {

    margin: 0 0 10px;

    color: #0f172a;

    font-size: 17px;

}


.related-list {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

}


.related-tag {

    display: inline-block;

    padding: 7px 12px;

    background: #f1f5f9;

    color: #334155;

    border-radius: 999px;

    font-size: 14px;

}


/* =========================================================
   ESTRATEGIAZ PRO
   ========================================================= */

.premium-preview {

    margin-top: 35px;

    padding: 35px;

    background: #eff6ff;

    border: 1px solid #cfe1ff;

    border-radius: 16px;

}


.premium-preview h2 {

    margin: 0 0 12px;

    color: #0f172a;

    font-size: 28px;

}


.premium-preview p {

    max-width: 720px;

    margin: 0 0 22px;

    color: #475569;

    line-height: 1.6;

}


.pro-button {

    background: #2563eb;

    color: white;

}


.pro-button:hover {

    background: #1d4ed8;

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {

    .case-page {

        padding:
            30px
            18px
            60px;

    }


    .case-header {

        grid-template-columns: 1fr;

        gap: 30px;

    }


    .case-information h1 {

        font-size: 40px;

    }


    .score-card {

        max-width: none;

    }


    .level-two {

        padding: 28px 20px;

    }


    .level-two-header h2 {

        font-size: 28px;

    }


    .level-two-actions {

        flex-direction: column;

        align-items: stretch;

    }


    .primary-button,
    .secondary-button {

        width: 100%;

        box-sizing: border-box;

    }


    .login-required {

        padding: 35px 20px;

    }


    .case-content {

        padding: 24px 20px;

    }

}

.case-analysis-layout {

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        320px;

    gap: 32px;

    align-items: start;

}


.case-sidebar {

    position: sticky;

    top: 24px;

}


@media (max-width: 900px) {

    .case-analysis-layout {

        grid-template-columns: 1fr;

    }


    .case-sidebar {

        position: static;

    }

}

.case-logo {
    margin: 10px 0 20px;
    height: 120px;

    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.case-logo img {
    max-width: 280px;
    max-height: 120px;

    width: auto;
    height: auto;

    object-fit: contain;
    display: block;
}

</style>

</BaseLayout>