---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const cases = await getCollection("cases");

    return cases.map((caso) => ({
        params: {
            slug: caso.id,
        },
        props: {
            caso,
        },
    }));
}

const { caso } = Astro.props;

const { Content } = await render(caso);

const autores = caso.data.autores ?? [];
const livros = caso.data.livros ?? [];
const frameworks = caso.data.frameworks ?? [];
const tags = caso.data.tags ?? [];
const problema = caso.data.problema ?? [];
---

<BaseLayout
    title={`${caso.data.title} | EstratégiaZ`}
    description={`Case EstratégiaZ: ${caso.data.title}`}
>

<div class="detail-page">

    <!-- =========================================
         CABEÇALHO
         ========================================= -->

    <div class="case-header">

        <div class="case-main">

            <span class="case-kicker">
                CASE ESTRATÉGICO
            </span>

            <h1>
                {caso.data.title}
            </h1>

            {caso.data.empresa && (
                <p>
                    <strong>Empresa:</strong>
                    {caso.data.empresa}
                </p>
            )}

            {caso.data.setor && (
                <p>
                    <strong>Setor:</strong>
                    {caso.data.setor}
                </p>
            )}

            {caso.data.pais && (
                <p>
                    <strong>País:</strong>
                    {caso.data.pais}
                </p>
            )}

            {caso.data.tipo_case && (
                <p>
                    <strong>Tipo:</strong>
                    {caso.data.tipo_case}
                </p>
            )}

            {caso.data.fonte && (
                <p>
                    <strong>Fonte:</strong>
                    {caso.data.fonte}
                </p>
            )}

        </div>


        <!-- =========================================
             SCORE
             ========================================= -->

        <div class="score-card">

            <span class="score-label">
                ESTRATEGIAZ SCORE
            </span>

            <div class="score">
                9.5
                <span>/10</span>
            </div>

            <div class="score-stars">
                ★★★★★
            </div>

            <p>
                Avaliação editorial EstratégiaZ
            </p>

        </div>

    </div>


    <!-- =========================================
         PROBLEMA ESTRATÉGICO
         ========================================= -->

    {problema.length > 0 && (

        <section class="case-problem">

            <span class="community-kicker">
                DESAFIO ESTRATÉGICO
            </span>

            <h2>
                Qual era o problema?
            </h2>

            <ul>
                {problema.map((item) => (
                    <li>{item}</li>
                ))}
            </ul>

        </section>

    )}


    <!-- =========================================
         CONTEÚDO
         ========================================= -->

    <div class="content">

        <Content />

    </div>


    <!-- =========================================
         CONTEÚDOS RELACIONADOS
         ========================================= -->

    <section class="related-content">

        <span class="community-kicker">
            CONEXÕES ESTRATÉGICAS
        </span>

        <h2>
            Este case se relaciona com
        </h2>


        {autores.length > 0 && (

            <div class="related-group">

                <h3>
                    Autores
                </h3>

                <div class="related-list">

                    {autores.map((autor) => (

                        <span class="related-tag">
                            {autor}
                        </span>

                    ))}

                </div>

            </div>

        )}


        {livros.length > 0 && (

            <div class="related-group">

                <h3>
                    Livros
                </h3>

                <div class="related-list">

                    {livros.map((livro) => (

                        <span class="related-tag">
                            {livro}
                        </span>

                    ))}

                </div>

            </div>

        )}


        {frameworks.length > 0 && (

            <div class="related-group">

                <h3>
                    Frameworks
                </h3>

                <div class="related-list">

                    {frameworks.map((framework) => (

                        <span class="related-tag">
                            {framework}
                        </span>

                    ))}

                </div>

            </div>

        )}


        {tags.length > 0 && (

            <div class="related-group">

                <h3>
                    Temas
                </h3>

                <div class="related-list">

                    {tags.map((tag) => (

                        <span class="related-tag">
                            #{tag}
                        </span>

                    ))}

                </div>

            </div>

        )}

    </section>


    <!-- =========================================
         ÁREA PREMIUM — PRÉVIA
         ========================================= -->

    <section class="premium-preview">

        <span class="premium-kicker">
            INTELIGÊNCIA ESTRATÉGICA
        </span>

        <h2>
            Quer explorar outros casos relacionados?
        </h2>

        <p>
            O EstratégiaZ está construindo uma base de casos
            que conecta empresas, autores, livros e frameworks
            a situações reais de estratégia.
        </p>

        <button type="button">
            Explorar inteligência estratégica
        </button>

    </section>

</div>

</BaseLayout>


<style>

.case-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: start;
}

.case-main h1 {
    font-size: 48px;
    line-height: 1.15;
    margin: 12px 0 30px;
}

.case-main p {
    font-size: 18px;
    margin-bottom: 10px;
}

.case-kicker,
.community-kicker,
.premium-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #64748b;
}

.case-problem {
    margin-top: 45px;
    padding: 28px 30px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
}

.case-problem h2 {
    margin: 8px 0 18px;
    font-size: 28px;
}

.case-problem ul {
    margin-left: 22px;
}

.case-problem li {
    margin-bottom: 8px;
}

.related-content {
    margin-top: 60px;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
}

.related-content h2 {
    margin: 8px 0 30px;
    font-size: 28px;
}

.related-group {
    margin-bottom: 28px;
}

.related-group:last-child {
    margin-bottom: 0;
}

.related-group h3 {
    margin-bottom: 10px;
    font-size: 18px;
}

.related-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.related-tag {
    padding: 7px 12px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    font-size: 14px;
}

.premium-preview {
    margin-top: 40px;
    padding: 35px;
    border: 1px solid #dbeafe;
    border-radius: 18px;
    background: #eff6ff;
}

.premium-preview h2 {
    margin: 8px 0 12px;
    font-size: 28px;
}

.premium-preview p {
    max-width: 700px;
    margin-bottom: 22px;
    color: #475569;
}

.premium-preview button {
    border: 0;
    border-radius: 10px;
    padding: 13px 20px;
    background: var(--primary);
    color: white;
    font-family: inherit;
    font-weight: 700;
    cursor: pointer;
}

.premium-preview button:hover {
    background: var(--primary-dark);
}


@media (max-width: 800px) {

    .case-header {
        grid-template-columns: 1fr;
    }

    .case-main h1 {
        font-size: 38px;
    }

    .score-card {
        max-width: 320px;
    }

}

</style>