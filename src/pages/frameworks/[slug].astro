---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {

  const frameworks =
    await getCollection("frameworks");

  return frameworks.map((framework) => ({

    params: {
      slug: framework.id,
    },

    props: {
      framework,
    },

  }));

}


const { framework } = Astro.props;


const { Content } =
  await render(framework);


const score =
  framework.data.score ?? 0;


const aplicabilidade =
  framework.data.aplicabilidade ??
  "Não avaliada";


const implementacao =
  framework.data.implementacao ??
  "Não avaliada";


const relevancia =
  framework.data.relevancia ??
  "Não avaliada";


const atualidade =
  framework.data.atualidade ??
  "Não avaliada";


const facilidade =
  framework.data.facilidade ??
  "Não avaliada";


const profundidade =
  framework.data.profundidade ??
  "Não avaliada";


const custo =
  framework.data.custo ??
  "Não avaliado";


const tempoAplicacao =
  framework.data.tempo_aplicacao ??
  "Não avaliado";

const frameworkSchema = {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",

    "name": framework.data.title,

    "url": `https://estrategiaz.com/frameworks/${framework.id}`,

    ...(framework.data.categoria && {
        "termCode": framework.data.categoria
    }),

    ...(framework.data.criador && {
        "creator": {
            "@type": "Person",
            "name": Array.isArray(framework.data.criador)
                ? framework.data.criador.join(", ")
                : framework.data.criador
        }
    }),

    ...(framework.data.ano && {
        "dateCreated": `${framework.data.ano}-01-01`
    }),

    ...(framework.data.tipo && {
        "inDefinedTermSet": {
            "@type": "DefinedTermSet",
            "name": framework.data.tipo
        }
    })
};
---

<BaseLayout
    title={`${framework.data.title} | Framework Estratégico | EstratégiaZ`}
    description={`Conheça o framework ${framework.data.title}, sua aplicação e relevância para a estratégia empresarial.`}
    canonical={`https://estrategiaz.com/frameworks/${framework.id}`}
    ogType="article"
    schema={frameworkSchema}
>


  <main class="container framework-page">


    <!-- =====================================================
         CABEÇALHO
         ===================================================== -->

    <div class="framework-header">


      <!-- INFORMAÇÕES -->

      <div class="framework-main">

        <h1>
          {framework.data.title}
        </h1>


        <div class="framework-info">


          {framework.data.criador && (

            <p>

              <strong>
                Criador:
              </strong>

              {framework.data.criador}

            </p>

          )}


          {framework.data.ano && (

            <p>

              <strong>
                Ano:
              </strong>

              {framework.data.ano}

            </p>

          )}


          {framework.data.categoria && (

            <p>

              <strong>
                Categoria:
              </strong>

              {framework.data.categoria}

            </p>

          )}

        </div>

      </div>


      <!-- ===================================================
           ESTRATEGIAZ SCORE
           =================================================== -->

      <div class="score-card">


        <span class="score-label">
          ESTRATEGIAZ SCORE
        </span>


        <div class="score">

          {score.toFixed(1)}

          <span>
            /10
          </span>

        </div>


        <div class="score-stars">
          ★★★★★
        </div>


        <p>
          Avaliação editorial EstratégiaZ
        </p>

      </div>

    </div>



    <!-- =====================================================
         LAYOUT PRINCIPAL
         ===================================================== -->

    <div class="framework-layout">


      <!-- ===================================================
           CONTEÚDO PRINCIPAL
           =================================================== -->

      <main class="framework-primary">


        <!-- =================================================
             CONTEÚDO ORIGINAL DO OBSIDIAN

             Fica oculto e serve como fonte para montar
             o resumo público.
             ================================================= -->

        <article
          id="framework-content-source"
          class="framework-content-source"
        >

          <Content />

        </article>



        <!-- =================================================
             RESUMO PÚBLICO
             ================================================= -->

        <div
          id="framework-public-summary"
          class="framework-public-summary"
        ></div>



        <!-- =================================================
             CTA NÍVEL 2
             ================================================= -->

        <div
          id="level-two-cta"
          class="level-two-cta"
        >

          <div class="level-two-cta-content">


            <span class="level-two-kicker">
              INTELIGÊNCIA ESTRATÉGICA
            </span>


            <h2>

              Quer conhecer mais sobre
              {framework.data.title}?

            </h2>


            <p>

              Acesse a análise ampliada e participe
              como avaliador da comunidade EstratégiaZ.

            </p>


            <a
              href={`/login?redirect=/frameworks/${framework.id}`}
              class="level-two-button"
            >

              Conheça mais

            </a>

          </div>

        </div>



        <!-- =================================================
             NÍVEL 2
             ================================================= -->

        <div
          id="level-two-content"
          class="level-two-content"
          hidden
        >


          <!-- ===============================================
               AVALIAÇÕES EDITORIAIS
               =============================================== -->

          <div class="rating-grid">


            <div class="rating-item">

              <span>
                Aplicabilidade
              </span>

              <strong>
                {aplicabilidade}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Implementação
              </span>

              <strong>
                {implementacao}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Relevância
              </span>

              <strong>
                {relevancia}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Atualidade
              </span>

              <strong>
                {atualidade}
              </strong>

            </div>


            <!-- CARACTERÍSTICAS EDITORIAIS -->

            <div class="rating-item">

              <span>
                Facilidade de aplicação
              </span>

              <strong>
                {facilidade}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Profundidade
              </span>

              <strong>
                {profundidade}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Custo
              </span>

              <strong>
                {custo}
              </strong>

            </div>


            <div class="rating-item">

              <span>
                Tempo de aplicação
              </span>

              <strong>
                {tempoAplicacao}
              </strong>

            </div>


          </div>



          <!-- ===============================================
               CONTEÚDO COMPLETO DO OBSIDIAN
               =============================================== -->

          <article class="framework-content">

            <Content />

          </article>


        </div>

      </main>



      <!-- ===================================================
           SIDEBAR — COMUNIDADE
           =================================================== -->

      <aside class="framework-sidebar">


        <section
          class="community-rating"
          id="rating-area"
        >


          <!-- CABEÇALHO -->

          <div class="community-heading">


            <span class="community-eyebrow">
              AVALIAÇÃO DA COMUNIDADE
            </span>


            <h2>
              O que você acha deste framework?
            </h2>


            <p>

              Avalie este framework e compartilhe
              sua experiência com outros profissionais.

            </p>

          </div>



          <!-- =============================================
               MÉDIA DA COMUNIDADE
               ============================================= -->

          <div
            class="community-result"
            id="community-result"
          >


            <div
              id="community-average-stars"
              class="community-average-stars"
            >

              ☆☆☆☆☆

            </div>


            <div class="community-average-info">

              <strong id="community-average">
                —
              </strong>

              <span>
                /5
              </span>

            </div>


            <p id="community-count">
              Ainda não há avaliações.
            </p>

          </div>



          <!-- =============================================
               ESTRELAS DO USUÁRIO
               ============================================= -->

          <div
            id="rating-stars"
            data-conteudo-id={framework.id}
            class="rating-stars"
          >


            <button
              type="button"
              data-rating="1"
              aria-label="Avaliar com 1 estrela"
            >
              ★
            </button>


            <button
              type="button"
              data-rating="2"
              aria-label="Avaliar com 2 estrelas"
            >
              ★
            </button>


            <button
              type="button"
              data-rating="3"
              aria-label="Avaliar com 3 estrelas"
            >
              ★
            </button>


            <button
              type="button"
              data-rating="4"
              aria-label="Avaliar com 4 estrelas"
            >
              ★
            </button>


            <button
              type="button"
              data-rating="5"
              aria-label="Avaliar com 5 estrelas"
            >
              ★
            </button>


          </div>


          <p
            id="rating-hint"
            class="rating-hint"
          >

            Selecione uma nota de 1 a 5.

          </p>


          <div
            id="rating-message"
            class="rating-message"
            aria-live="polite"
          ></div>



          <!-- =============================================
               AVALIAÇÃO DO AVALIADOR
               ============================================= -->

          <div
            id="evaluator-area"
            class="evaluator-area"
            hidden
          >


            <div class="evaluator-heading">


              <span class="community-eyebrow">
                AVALIAÇÃO DO AVALIADOR
              </span>


              <h3>
                Avalie este framework
              </h3>


              <p>

                Sua avaliação ajuda a construir
                a inteligência coletiva do EstratégiaZ.

              </p>

            </div>



            <div class="criterion-rating">


              <!-- APLICABILIDADE -->

              <div class="criterion-item">


                <div class="criterion-label">

                  <strong>
                    Aplicabilidade
                  </strong>

                  <span>
                    É útil para situações reais?
                  </span>

                </div>


                <div
                  class="criterion-stars"
                  data-criterion="aplicabilidade"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>



              <!-- IMPLEMENTAÇÃO -->

              <div class="criterion-item">


                <div class="criterion-label">

                  <strong>
                    Implementação
                  </strong>

                  <span>
                    É fácil transformar em prática?
                  </span>

                </div>


                <div
                  class="criterion-stars"
                  data-criterion="implementacao"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>



              <!-- RELEVÂNCIA -->

              <div class="criterion-item">


                <div class="criterion-label">

                  <strong>
                    Relevância
                  </strong>

                  <span>
                    O framework continua relevante?
                  </span>

                </div>


                <div
                  class="criterion-stars"
                  data-criterion="relevancia"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>



              <!-- ATUALIDADE -->

              <div class="criterion-item">


                <div class="criterion-label">

                  <strong>
                    Atualidade
                  </strong>

                  <span>
                    Continua atual para os negócios?
                  </span>

                </div>


                <div
                  class="criterion-stars"
                  data-criterion="atualidade"
                >

                  <button type="button" data-value="1">
                    ★
                  </button>

                  <button type="button" data-value="2">
                    ★
                  </button>

                  <button type="button" data-value="3">
                    ★
                  </button>

                  <button type="button" data-value="4">
                    ★
                  </button>

                  <button type="button" data-value="5">
                    ★
                  </button>

                </div>

              </div>


            </div>



            <!-- BOTÃO -->

            <button
