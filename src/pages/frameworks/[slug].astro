---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const frameworks = await getCollection("frameworks");

    return frameworks.map((framework) => ({
        params: {
            slug: framework.id,
        },
        props: {
            framework,
        },
    }));
}

const { framework } = Astro.props;

const { Content } = await render(framework);

const score = framework.data.score ?? 0;
const aplicabilidade = framework.data.aplicabilidade ?? "Não avaliada";
const facilidade = framework.data.facilidade ?? "Não avaliada";
const profundidade = framework.data.profundidade ?? "Não avaliada";
const custo = framework.data.custo ?? "Não avaliado";
const tempoAplicacao = framework.data.tempo_aplicacao ?? "Não avaliado";
---

<BaseLayout
    title={`${framework.data.title} | EstratégiaZ`}
    description={`Framework estratégico: ${framework.data.title}`}
>

<div class="detail-page">

    <div class="detail-header">

        <div class="detail-main">

            <h1>{framework.data.title}</h1>

            {framework.data.criador && (
                <p>
                    <strong>Criador:</strong> {framework.data.criador}
                </p>
            )}

            {framework.data.ano && (
                <p>
                    <strong>Ano:</strong> {framework.data.ano}
                </p>
            )}

            {framework.data.categoria && (
                <p>
                    <strong>Categoria:</strong> {framework.data.categoria}
                </p>
            )}

        </div>


        <div class="score-card">

            <span class="score-label">
                ESTRATEGIAZ SCORE
            </span>

            <div class="score">
                {score.toFixed(1)}
                <span>/10</span>
            </div>

            <div class="score-stars">
                ★★★★★
            </div>

            <p>
                Avaliação editorial EstratégiaZ
            </p>

        </div>

    </div>


    <div class="ratings-grid">

        <div class="rating-item">
            <span>Aplicabilidade</span>
            <strong>{aplicabilidade}</strong>
        </div>

        <div class="rating-item">
            <span>Facilidade de aplicação</span>
            <strong>{facilidade}</strong>
        </div>

        <div class="rating-item">
            <span>Profundidade</span>
            <strong>{profundidade}</strong>
        </div>

        <div class="rating-item">
            <span>Custo</span>
            <strong>{custo}</strong>
        </div>

        <div class="rating-item">
            <span>Tempo de aplicação</span>
            <strong>{tempoAplicacao}</strong>
        </div>

    </div>


    <div class="content">

        <Content />

    </div>

</div>

</BaseLayout>