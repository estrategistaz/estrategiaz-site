---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const frameworks = await getCollection("frameworks");

    return frameworks.map((framework) => ({
        params: {
            slug: framework.id,
        },
        props: {
            framework,
        },
    }));
}

const { framework } = Astro.props;
const { Content } = await render(framework);
---

<BaseLayout
    title={framework.data.title}
    description={`Framework estratégico: ${framework.data.title}`}
>

    <article class="content">

        <h1>{framework.data.title}</h1>

        {framework.data.criador && (
            <p>
                <strong>Criador:</strong> {framework.data.criador}
            </p>
        )}

        {framework.data.ano && (
            <p>
                <strong>Ano:</strong> {framework.data.ano}
            </p>
        )}

        {framework.data.categoria && (
            <p>
                <strong>Categoria:</strong> {framework.data.categoria}
            </p>
        )}

        {framework.data.score !== undefined && (
            <p>
                ⭐ <strong>EstratégiaZ:</strong> {framework.data.score}/10
            </p>
        )}

        {framework.data.aplicabilidade && (
            <p>
                <strong>Aplicabilidade:</strong> {framework.data.aplicabilidade}
            </p>
        )}

        {framework.data.facilidade && (
            <p>
                <strong>Facilidade:</strong> {framework.data.facilidade}
            </p>
        )}

        {framework.data.profundidade && (
            <p>
                <strong>Profundidade:</strong> {framework.data.profundidade}
            </p>
        )}

        {framework.data.custo && (
            <p>
                <strong>Custo:</strong> {framework.data.custo}
            </p>
        )}

        {framework.data.tempo_aplicacao && (
            <p>
                <strong>Tempo de aplicação:</strong> {framework.data.tempo_aplicacao}
            </p>
        )}

        <hr />

        <Content />

    </article>

</BaseLayout>