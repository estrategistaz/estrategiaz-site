        </section>

      </aside>

    </div>

  </main>

</BaseLayout>



<script>

  import { supabase } from "../../lib/supabase.js";


  /* ========================================================
     ELEMENTOS
     ======================================================== */

  const stars =
    document.querySelectorAll<HTMLButtonElement>(
      "#rating-stars button"
    );


  const ratingContainer =
    document.querySelector(
      "#rating-stars"
    );


  const averageStars =
    document.querySelector<HTMLElement>(
      "#community-average-stars"
    );


  const average =
    document.querySelector<HTMLElement>(
      "#community-average"
    );


  const count =
    document.querySelector<HTMLElement>(
      "#community-count"
    );


  const hint =
    document.querySelector(
      "#rating-hint"
    );


  const message =
    document.querySelector(
      "#rating-message"
    );


  const evaluatorArea =
    document.querySelector(
      "#evaluator-area"
    );


  const evaluatorSubmit =
    document.querySelector(
      "#evaluator-submit"
    );


  const evaluatorMessage =
    document.querySelector(
      "#evaluator-message"
    );


  const commentArea =
    document.querySelector(
      "#comment-area"
    );


  const commentInput =
    document.querySelector(
      "#comentario"
    );


  const commentButton =
    document.querySelector(
      "#comment-button"
    );


  const commentCounter =
    document.querySelector(
      "#comment-counter"
    );


  const reviewUserName =
    document.querySelector(
      "#review-user-name"
    );


  const reviewAvatar =
    document.querySelector(
      "#review-avatar"
    );


  const publicSummary =
    document.querySelector(
      "#framework-public-summary"
    );


  const contentSource =
    document.querySelector(
      "#framework-content-source"
    );


  const levelTwoContent =
    document.querySelector(
      "#level-two-content"
    );


  const levelTwoCta =
    document.querySelector(
      "#level-two-cta"
    );


  /* ========================================================
     VERIFICAÇÃO
     ======================================================== */

  if (
    !(ratingContainer instanceof HTMLElement) ||
    !(hint instanceof HTMLElement) ||
    !(message instanceof HTMLElement)
  ) {

    throw new Error(
      "Elementos da avaliação do framework não encontrados."
    );

  }


  const conteudoTipo =
    "framework";


  const conteudoId =
    ratingContainer.dataset.conteudoId;


  if (!conteudoId) {

    throw new Error(
      "ID do framework não encontrado."
    );

  }



  /* ========================================================
     RESUMO PÚBLICO
     ======================================================== */

  function montarResumoPublico() {


    if (
      !(publicSummary instanceof HTMLElement) ||
      !(contentSource instanceof HTMLElement)
    ) {

      return;

    }


    const elementos =
      Array.from(
        contentSource.children
      );


    let secaoAtual = 0;

    let capturando = false;


    elementos.forEach(
      (elemento) => {


        const tag =
          elemento.tagName.toLowerCase();


        /*
         * As duas primeiras seções do Markdown
         * serão públicas:
         *
         * ## O que é
         * ## Para que serve
         */

        if (tag === "h2") {

          secaoAtual++;

          capturando =
            secaoAtual <= 2;

        }


        if (capturando) {

          publicSummary.appendChild(
            elemento.cloneNode(true)
          );

        }

      }
    );

  }



  /* ========================================================
     VERIFICA NÍVEL DO USUÁRIO
     ======================================================== */

  async function verificarNivelDoUsuario() {


    const {
      data: {
        user
      }
    } =
      await supabase.auth.getUser();


    /*
     * Visitante:
     *
     * resumo público permanece visível.
     */

    if (!user) {

      return;

    }


    /*
     * Usuário logado:
     *
     * libera Nível 2.
     */

    if (
      levelTwoContent instanceof HTMLElement
    ) {

      levelTwoContent.hidden =
        false;

    }


    /*
     * Esconde CTA.
     */

    if (
      levelTwoCta instanceof HTMLElement
    ) {

      levelTwoCta.hidden =
        true;

    }


    /*
     * Esconde resumo público.
     */

    if (
      publicSummary instanceof HTMLElement
    ) {

      publicSummary.hidden =
        true;

    }


    /*
     * Nome do usuário.
     */

    const nome =
      user.user_metadata?.full_name ||
      user.user_metadata?.name ||
      user.user_metadata?.nome ||
      user.email?.split("@")[0] ||
      "Avaliador";


    if (
      reviewUserName instanceof HTMLElement
    ) {

      reviewUserName.textContent =
        nome;

    }


    /*
     * Avatar.

     */

    if (
      reviewAvatar instanceof HTMLElement
    ) {

      reviewAvatar.textContent =
        nome
          .charAt(0)
          .toUpperCase();

    }

  }



  /* ========================================================
     MÉDIA DA COMUNIDADE
     ======================================================== */

  async function carregarMediaComunidade() {


    if (
      !(average instanceof HTMLElement) ||
      !(count instanceof HTMLElement) ||
      !(averageStars instanceof HTMLElement)
    ) {

      return;

    }


    const {
      data,
      error
    } =
      await supabase
        .from("avaliacoes")
        .select("nota")
        .eq(
          "conteudo_tipo",
          conteudoTipo
        )
        .eq(
          "conteudo_id",
          conteudoId
        );


    if (error) {

      console.error(
        "Erro ao carregar avaliações:",
        error
      );


      average.textContent =
        "—";


      count.textContent =
        "Não foi possível carregar as avaliações.";


      averageStars.textContent =
        "☆☆☆☆☆";


      return;

    }


    if (
      !data ||
      data.length === 0
    ) {

      average.textContent =
        "—";


      count.textContent =
        "Ainda não há avaliações.";


      averageStars.textContent =
        "☆☆☆☆☆";


      return;

    }


    const quantidade =
      data.length;


    const soma =
      data.reduce(
        (
          total: number,
          avaliacao: { nota: number }
        ) =>
          total +
          Number(
            avaliacao.nota
          ),
        0
      );


    const media =
      soma / quantidade;


    average.textContent =
      media.toFixed(1);


    count.textContent =
      quantidade === 1
        ? "1 avaliação da comunidade."
        : `${quantidade} avaliações da comunidade.`;


    const estrelasCheias =
      Math.round(media);


    let estrelas =
      "";


    for (
      let i = 1;
      i <= 5;
      i++
    ) {

      estrelas +=
        i <= estrelasCheias
          ? "★"
          : "☆";

    }


    averageStars.textContent =
      estrelas;

  }



  /* ========================================================
     ESTRELAS DA COMUNIDADE
     ======================================================== */

  stars.forEach(
    (star) => {


      star.addEventListener(
        "click",
        async () => {


          const nota =
            Number(
              star.dataset.rating
            );


          /*
           * Verifica login.
           */

          const {
            data: {
              user
            }
          } =
            await supabase.auth.getUser();


          /*
           * Visitante vai para cadastro.
           */

          if (!user) {

            window.location.href =
              `/cadastro?redirect=/frameworks/${conteudoId}`;

            return;

          }


          /*
           * Desabilita enquanto salva.
           */

          stars.forEach(
            (button) => {

              button.disabled =
                true;

            }
          );


          message.textContent =
            "Registrando sua avaliação...";


          /*
           * Cria avaliação.
           */

          const {
            error
          } =
            await supabase
              .from("avaliacoes")
              .insert({

                user_id:
                  user.id,

                conteudo_tipo:
                  conteudoTipo,

                conteudo_id:
                  conteudoId,

                nota,

                publicado:
                  false

              });


          if (error) {

            console.error(
              "Erro Supabase:",
              error
            );


            message.textContent =
              `Erro ao registrar: ${error.message}`;


            stars.forEach(
              (button) => {

                button.disabled =
                  false;

              }
            );


            return;

          }


          /*
           * Marca estrelas.
           */

          stars.forEach(
            (button) => {

              const rating =
                Number(
                  button.dataset.rating
                );


              button.classList.toggle(
                "selected",
                rating <= nota
              );

            }
          );


          hint.textContent =
            "Você já avaliou este framework.";


          message.textContent =
            `Sua avaliação: ${nota}/5`;


          /*
           * Libera avaliação dos critérios.
           */

          if (
            evaluatorArea instanceof HTMLElement
          ) {

            evaluatorArea.hidden =
              false;

          }

        }
      );

    }
  );



  /* ========================================================
     CRITÉRIOS DO AVALIADOR
     ======================================================== */

  const criterionStars =
    document.querySelectorAll<HTMLElement>(
      ".criterion-stars"
    );


  const criterios:
    Record<string, number> = {};



  criterionStars.forEach(
    (grupo) => {


      const criterio =
        grupo.dataset.criterion;


      if (!criterio) {

        return;

      }


      const botoes =
        grupo.querySelectorAll<HTMLButtonElement>(
          "button"
        );


      botoes.forEach(
        (botao) => {


          botao.addEventListener(
            "click",
            () => {


              const valor =
                Number(
                  botao.dataset.value
                );


              criterios[criterio] =
                valor;


              botoes.forEach(
                (item) => {


                  const itemValor =
                    Number(
                      item.dataset.value
                    );


                  item.classList.toggle(
                    "selected",
                    itemValor <= valor
                  );

                }
              );

            }
          );

        }
      );

    }
  );



  /* ========================================================
     SALVAR AVALIAÇÃO DO AVALIADOR
     ======================================================== */

  if (
    evaluatorSubmit instanceof HTMLButtonElement
  ) {


    evaluatorSubmit.addEventListener(
      "click",
      async () => {


        const {
          data: {
            user
          }
        } =
          await supabase.auth.getUser();


        if (!user) {

          window.location.href =
            `/cadastro?redirect=/frameworks/${conteudoId}`;

          return;

        }


        /*
         * Os quatro critérios são obrigatórios.
         */

        if (
          !criterios.aplicabilidade ||
          !criterios.implementacao ||
          !criterios.relevancia ||
          !criterios.atualidade
        ) {


          if (
            evaluatorMessage instanceof HTMLElement
          ) {

            evaluatorMessage.textContent =
              "Avalie os quatro critérios antes de salvar.";

          }


          return;

        }


        evaluatorSubmit.disabled =
          true;


        if (
          evaluatorMessage instanceof HTMLElement
        ) {

          evaluatorMessage.textContent =
            "Salvando sua avaliação...";

        }


        /*
         * Atualiza a avaliação criada anteriormente.
         */

        const {
          error
        } =
          await supabase
            .from("avaliacoes")
            .update({

              aplicabilidade:
                criterios.aplicabilidade,

              implementacao:
                criterios.implementacao,

              relevancia:
                criterios.relevancia,

              atualidade:
                criterios.atualidade

            })
            .eq(
              "user_id",
              user.id
            )
            .eq(
              "conteudo_tipo",
              conteudoTipo
            )
            .eq(
              "conteudo_id",
              conteudoId
            );


        if (error) {

          console.error(
            "Erro ao salvar critérios:",
            error
          );


          if (
            evaluatorMessage instanceof HTMLElement
          ) {

            evaluatorMessage.textContent =
              `Erro ao salvar: ${error.message}`;

          }


          evaluatorSubmit.disabled =
            false;


          return;

        }


        if (
          evaluatorMessage instanceof HTMLElement
        ) {

          evaluatorMessage.textContent =
            "Sua avaliação foi salva com sucesso.";

        }


        evaluatorSubmit.textContent =
          "Avaliação salva";


        /*
         * Libera comentário.
         */

        if (
          commentArea instanceof HTMLElement
        ) {

          commentArea.hidden =
            false;

        }

      }
    );

  }



  /* ========================================================
     CONTADOR DO COMENTÁRIO
     ======================================================== */

  if (
    commentInput instanceof HTMLTextAreaElement &&
    commentCounter instanceof HTMLElement
  ) {


    commentInput.addEventListener(
      "input",
      () => {


        commentCounter.textContent =
          `${commentInput.value.length}/1000`;

      }
    );

  }



  /* ========================================================
     PUBLICAR COMENTÁRIO
     ======================================================== */

  if (
    commentButton instanceof HTMLButtonElement
  ) {


    commentButton.addEventListener(
      "click",
      async () => {


        const {
          data: {
            user
          }
        } =
          await supabase.auth.getUser();


        if (!user) {

          window.location.href =
            `/cadastro?redirect=/frameworks/${conteudoId}`;

          return;

        }


        if (
          !(commentInput instanceof HTMLTextAreaElement)
        ) {

          return;

        }


        const comentario =
          commentInput.value.trim();


        if (!comentario) {

          commentInput.focus();

          return;

        }


        commentButton.disabled =
          true;


        commentButton.textContent =
          "Publicando...";


        const {
          error
        } =
          await supabase
            .from("avaliacoes")
            .update({

              comentario,

              depoimento:
                comentario,

              publicado:
                true

            })
            .eq(
              "user_id",
              user.id
            )
            .eq(
              "conteudo_tipo",
              conteudoTipo
            )
            .eq(
              "conteudo_id",
              conteudoId
            );


        if (error) {

          console.error(
            "Erro ao publicar comentário:",
            error
          );


          commentButton.disabled =
            false;


          commentButton.textContent =
            "Publicar comentário";


          return;

        }


        commentButton.textContent =
          "Comentário publicado";


        commentInput.disabled =
          true;

      }
    );

  }



  /* ========================================================
     INICIALIZAÇÃO
     ======================================================== */

  montarResumoPublico();

  verificarNivelDoUsuario();

  carregarMediaComunidade();

</script>



