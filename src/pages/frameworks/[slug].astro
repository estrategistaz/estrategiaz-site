              aria-live="polite"
            ></p>


          </div>



          <!-- =============================================
               COMENTÁRIO
               ============================================= -->

          <div
            id="comment-area"
            class="comment-area"
            hidden
          >


            <div class="review-user">


              <div
                class="review-avatar"
                id="review-avatar"
              >
                E
              </div>


              <div class="review-user-info">


                <strong id="review-user-name">
                  Avaliando como você
