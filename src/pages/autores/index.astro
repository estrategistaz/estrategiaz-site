---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const autores = await getCollection("autores");
---

<BaseLayout
    title="Autores | EstratégiaZ"
    description="Grandes pensadores da estratégia empresarial."
>

<section class="container">

    <h1>Autores</h1>

    <p>
        Grandes pensadores da estratégia empresarial.
    </p>

    <div class="grid">

        {autores.map((autor) => (

            <a
                class="card"
                href={`/autores/${autor.id}`}
            >

                <!-- FOTO DO AUTOR -->

                {autor.data.foto && (
                    <div class="card-image">
                        <img
                            src={autor.data.foto}
                            alt={`Foto de ${autor.data.title}`}
                            loading="lazy"
                        />
                    </div>
                )}

                <!-- INFORMAÇÕES -->

                <div class="card-content">

                    <h2>
                        {autor.data.title}
                    </h2>

                    {autor.data.universidade && (
                        <p>
                            {Array.isArray(autor.data.universidade)
                                ? autor.data.universidade.join(" • ")
                                : autor.data.universidade}
                        </p>
                    )}

                    {autor.data.pais && (
                        <small>
                            {autor.data.pais}
                        </small>
                    )}

                </div>

            </a>

        ))}

    </div>

</section>

</BaseLayout>


<style>

.grid {

    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(280px, 1fr));

    gap: 24px;

    margin-top: 40px;

}


.card {

    display: block;

    background: white;

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
        0 8px 20px rgba(0,0,0,.06);

    transition:
        transform .25s,
        box-shadow .25s;

    text-decoration: none;

    color: inherit;

}


.card:hover {

    transform: translateY(-5px);

    box-shadow:
        0 15px 35px rgba(0,0,0,.10);

}


/* =====================================================
   IMAGEM
   ===================================================== */

.card-image {

    width: 100%;

    height: 280px;

    overflow: hidden;

    background: #f1f5f9;

}


.card-image img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    object-position: center;

    transition: transform .35s ease;

}


.card:hover .card-image img {

    transform: scale(1.04);

}


/* =====================================================
   CONTEÚDO DO CARD
   ===================================================== */

.card-content {

    padding: 24px 26px 28px;

}


.card h2 {

    margin: 0 0 12px;

    font-size: 24px;

    line-height: 1.2;

    color: #102a43;

}


.card p {

    margin: 0 0 10px;

    color: #64748b;

    line-height: 1.5;

}


.card small {

    color: #94a3b8;

}


</style>