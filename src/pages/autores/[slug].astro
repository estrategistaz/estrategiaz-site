  <script>
    import { supabase } from "../../lib/supabase.js";


    /*
     * ELEMENTOS DA PÁGINA
     */

    const stars =
      document.querySelectorAll<HTMLButtonElement>(
        "#rating-stars button"
      );


    const ratingContainer =
      document.querySelector("#rating-stars");


    const message =
      document.querySelector("#rating-message");


    const hint =
      document.querySelector("#rating-hint");


    const commentArea =
      document.querySelector("#comment-area");


    const commentInput =
      document.querySelector("#comentario");


    const commentButton =
      document.querySelector("#comment-button");


    const commentCounter =
      document.querySelector("#comment-counter");


    const userName =
      document.querySelector("#review-user-name");


    const avatar =
      document.querySelector("#review-avatar");


    const communityAverage =
      document.querySelector("#community-average");


    const communityCount =
      document.querySelector("#community-count");


    const communityAverageStars =
      document.querySelector(
        "#community-average-stars"
      );
    const levelTwoCTA =
  document.querySelector("#level-two-cta");

const levelTwoContent =
  document.querySelector("#level-two-content");

const publicSummary =
  document.querySelector("#autor-public-summary");

const contentSource =
  document.querySelector("#autor-content-source");

const evaluatorArea =
  document.querySelector("#evaluator-area");

const evaluatorSubmit =
  document.querySelector("#evaluator-submit");

const evaluatorMessage =
  document.querySelector("#evaluator-message");

const criterionContainers =
  document.querySelectorAll<HTMLElement>(
    ".criterion-stars"
  );

  const criterios: Record<string, number> = {};

criterionContainers.forEach((container) => {

  const criterio =
    container.dataset.criterion;

  if (!criterio) return;

  const buttons =
    container.querySelectorAll<HTMLButtonElement>(
      "button"
    );

  buttons.forEach((button) => {

    button.addEventListener("click", () => {

      const nota =
        Number(
          button.dataset.value
        );

      criterios[criterio] = nota;

      buttons.forEach((item) => {

        const valor =
          Number(
            item.dataset.value
          );

        item.classList.toggle(
          "selected",
          valor <= nota
        );

      });

    });

  });

});

    /*
     * VERIFICAÇÕES
     */

    if (
      !(ratingContainer instanceof HTMLElement) ||
      !(message instanceof HTMLElement) ||
      !(hint instanceof HTMLElement) ||
      !(commentArea instanceof HTMLElement) ||
      !(commentInput instanceof HTMLTextAreaElement) ||
      !(commentButton instanceof HTMLButtonElement) ||
      !(commentCounter instanceof HTMLElement) ||
      !(userName instanceof HTMLElement) ||
      !(avatar instanceof HTMLElement) ||
      !(communityAverage instanceof HTMLElement) ||
      !(communityCount instanceof HTMLElement) ||
      !(communityAverageStars instanceof HTMLElement)
    ) {
      throw new Error(
        "Elementos da avaliação não encontrados."
      );
    }


    /*
     * DADOS DO CONTEÚDO
     */

    const conteudoTipo = "autor";


    const conteudoId =
      ratingContainer.dataset.conteudoId;


    if (!conteudoId) {

      throw new Error(
        "ID do autor não encontrado."
      );

    }

    /*
 * =========================================================
 * SALVAR AVALIAÇÃO DOS CRITÉRIOS
 * =========================================================
 */

if (
  evaluatorSubmit instanceof HTMLButtonElement &&
  evaluatorMessage instanceof HTMLElement
) {

  evaluatorSubmit.addEventListener(
    "click",
    async () => {

      /*
       * Verifica usuário autenticado
       */

      const {
        data: {
          user
        }
      } = await supabase.auth.getUser();


      /*
       * Se não estiver logado,
       * envia para login.
       */

      if (!user) {

        window.location.href =
          `/login?redirect=/autores/${conteudoId}`;

        return;

      }


      /*
       * Verifica se todos os critérios
       * foram avaliados.
       */

      const criteriosObrigatorios = [
        "aplicabilidade",
        "implementacao",
        "relevancia",
        "atualidade"
      ];


      const faltando =
        criteriosObrigatorios.filter(
          (criterio) =>
            !criterios[criterio]
        );


      if (faltando.length > 0) {

        evaluatorMessage.textContent =
          "Avalie todos os critérios antes de salvar.";

        return;

      }


      /*
       * Desabilita o botão durante o salvamento.
       */

      evaluatorSubmit.disabled = true;

      evaluatorSubmit.textContent =
        "Salvando...";


      /*
       * Verifica se o usuário já possui
       * uma avaliação deste autor.
       */

      const {
        data: existente,
        error: buscaError
      } =
        await supabase
          .from("avaliacoes")
          .select("id, nota")
          .eq(
            "user_id",
            user.id
          )
          .eq(
            "conteudo_tipo",
            conteudoTipo
          )
          .eq(
            "conteudo_id",
            conteudoId
          )
          .maybeSingle();


      if (buscaError) {

        console.error(
          "Erro ao buscar avaliação:",
          buscaError
        );

        evaluatorMessage.textContent =
          `Erro ao verificar avaliação: ${buscaError.message}`;

        evaluatorSubmit.disabled = false;

        evaluatorSubmit.textContent =
          "Salvar minha avaliação";

        return;

      }


      /*
       * Calcula a nota geral.
       *
       * A tabela possui "nota" como campo obrigatório
       * da avaliação principal.
       */

      const notaMedia =
        Math.round(
          (
            criterios.aplicabilidade +
            criterios.implementacao +
            criterios.relevancia +
            criterios.atualidade
          ) / 4
        );


      /*
       * Dados que serão salvos.
       */

      const dadosAvaliacao = {

        aplicabilidade:
          criterios.aplicabilidade,

        implementacao:
          criterios.implementacao,

        relevancia:
          criterios.relevancia,

        atualidade:
          criterios.atualidade,

        nota:
          notaMedia

      };


      let error;


      /*
       * ATUALIZA avaliação existente
       */

      if (existente) {

        const resultado =
          await supabase
            .from("avaliacoes")
            .update(
              dadosAvaliacao
            )
            .eq(
              "id",
              existente.id
            )
            .eq(
              "user_id",
              user.id
            );

        error =
          resultado.error;

      }


      /*
       * CRIA nova avaliação
       */

      else {

        const resultado =
          await supabase
            .from("avaliacoes")
            .insert({

              user_id:
                user.id,

              conteudo_tipo:
                conteudoTipo,

              conteudo_id:
                conteudoId,

              nota:
                notaMedia,

              aplicabilidade:
                criterios.aplicabilidade,

              implementacao:
                criterios.implementacao,

              relevancia:
                criterios.relevancia,

              atualidade:
                criterios.atualidade,

              publicado:
                false

            });

        error =
          resultado.error;

      }


      /*
       * ERRO
       */

      if (error) {

        console.error(
          "Erro ao salvar avaliação:",
          error
        );

        evaluatorMessage.textContent =
          `Não foi possível salvar sua avaliação: ${error.message}`;

        evaluatorSubmit.disabled =
          false;

        evaluatorSubmit.textContent =
          "Salvar minha avaliação";

        return;

      }


      /*
       * SUCESSO
       */

      evaluatorMessage.textContent =
        "Sua avaliação foi salva com sucesso.";

      evaluatorSubmit.textContent =
        "Avaliação salva ✓";


      /*
       * Mantém o botão desabilitado
       * para evitar cliques duplicados.
       */

      evaluatorSubmit.disabled =
        true;

    }
  );

}
    /*
     * PINTA AS ESTRELAS DO USUÁRIO
     */

    function pintarEstrelas(
      nota: number
    ) {

      stars.forEach(
        (button) => {

          const valor =
            Number(
              button.getAttribute(
                "data-rating"
              )
            );

          button.classList.toggle(
            "selected",
            valor <= nota
          );

        }
      );

    }


    /*
     * CARREGA A MÉDIA DA COMUNIDADE
     */

    async function carregarMediaComunidade() {

      const { data, error } = await supabase
  .from("avaliacoes")
  .update({
    comentario: comentario
  })
  .eq("user_id", user.id)
  .eq("conteudo_tipo", conteudoTipo)
  .eq("conteudo_id", conteudoId)
  .select();

console.log("RESULTADO DO COMENTÁRIO:", data);
console.log("ERRO DO COMENTÁRIO:", error);


      if (error) {

        console.error(
          "Erro ao carregar média da comunidade:",
          error
        );

        communityAverage.textContent =
          "—";

        communityCount.textContent =
          "Ainda não há avaliações.";

        communityAverageStars.textContent =
          "☆☆☆☆☆";

        return;

      }


      /*
       * Ainda não existem avaliações.
       */

            if (!data || data.length === 0) {

        communityAverage.textContent =
          "—";

        communityCount.textContent =
          "Ainda não há avaliações.";

        communityAverageStars.textContent =
          "☆☆☆☆☆";

        return;

      }


      const quantidade =
        data.length;


      const soma =
        data.reduce(
          (
            total: number,
            avaliacao: { nota: number }
          ) =>
            total + Number(avaliacao.nota),
          0
        );


      const media =
        soma / quantidade;


      /*
       * Mostra a média.
       */

      communityAverage.textContent =
        media.toFixed(1);


      /*
       * Mostra a quantidade.
       */

      if (quantidade === 1) {

        communityCount.textContent =
          "1 avaliação da comunidade.";

      } else {

        communityCount.textContent =
          `${quantidade} avaliações da comunidade.`;

      }


      /*
       * Calcula as estrelas visuais.
       *
       * Exemplo:
       *
       * 4.3 → ★★★★☆
       * 3.6 → ★★★★☆
       * 2.2 → ★★☆☆☆
       */

      const estrelasCheias =
        Math.round(media);


      let estrelas =
        "";

      for (
        let i = 1;
        i <= 5;
        i++
      ) {

        estrelas +=
          i <= estrelasCheias
            ? "★"
            : "☆";

      }


      communityAverageStars.textContent =
        estrelas;

    }


    /*
     * CARREGA A AVALIAÇÃO DO USUÁRIO
     */

    async function carregarAvaliacao() {

      const {
        data: {
          user
        }
      } =
        await supabase.auth.getUser();


      /*
       * Usuário ainda não está logado.
       */

      if (!user) {

        return;

      }


      const {
        data: avaliacao,
        error
      } =
        await supabase
          .from("avaliacoes")
          .select(
            "nota, comentario"
          )
          .eq(
            "user_id",
            user.id
          )
          .eq(
            "conteudo_tipo",
            conteudoTipo
          )
          .eq(
            "conteudo_id",
            conteudoId
          )
          .maybeSingle();


      if (error) {

        console.error(
          "Erro ao carregar avaliação:",
          error
        );

        return;

      }


      if (!avaliacao) {

        return;

      }


      /*
       * Mostra a avaliação já feita.
       */

      const notaAnterior =
        Number(
          avaliacao.nota
        );


      pintarEstrelas(
        notaAnterior
      );


      hint.textContent =
        "Você já avaliou este autor.";


      message.textContent =
        `Sua avaliação: ${notaAnterior}/5`;


      commentArea.hidden =
        false;


      /*
       * Nome do usuário.
       */

      const nome =
        user.user_metadata?.nome ||
        user.user_metadata?.full_name ||
        user.email ||
        "Avaliador";


      userName.textContent =
        `Avaliando como ${nome}`;


      avatar.textContent =
        nome
          .charAt(0)
          .toUpperCase();


      /*
       * Comentário existente.
       */

      if (avaliacao.comentario) {

        commentInput.value =
          avaliacao.comentario;


        commentCounter.textContent =
          `${avaliacao.comentario.length}/1000`;


        commentButton.textContent =
          "Atualizar comentário";

      }

    }

    /*
 * VERIFICA ACESSO AO NÍVEL 2
 */

async function verificarNivelDoUsuario() {

  const {
    data: {
      user
    }
  } = await supabase.auth.getUser();


  /*
   * Visitante:
   * mantém o conteúdo bloqueado.
   */

  if (!user) {
    return;
  }


  /*
   * Usuário logado:
   * libera o conteúdo do Nível 2.
   */

  if (
    levelTwoContent instanceof HTMLElement
  ) {

    levelTwoContent.hidden = false;

  }

  if (
  publicSummary instanceof HTMLElement
) {

  publicSummary.hidden = true;

}

  /*
   * Libera a avaliação do avaliador.
   */

  if (
    evaluatorArea instanceof HTMLElement
  ) {

    evaluatorArea.hidden = false;

  }


  /*
   * Esconde o botão "Conheça mais",
   * pois o usuário já está autenticado.
   */

  if (
    levelTwoCTA instanceof HTMLElement
  ) {

    levelTwoCTA.hidden = true;

  }

}
    /*
     * CLIQUE NAS ESTRELAS
     */

    stars.forEach(
      (star) => {

        star.addEventListener(
          "click",
          async () => {

            const nota =
              Number(
                star.getAttribute(
                  "data-rating"
                )
              );


            const {
              data: {
                user
              }
            } =
              await supabase.auth.getUser();


            /*
             * Usuário não logado.
             *
             * Vai para o login preservando
             * o autor.
             */

            if (!user) {

              window.location.href =
                `/login?redirect=/autores/${conteudoId}`;

              return;

            }


            /*
             * Desabilita as estrelas
             * durante o salvamento.
             */

            stars.forEach(
              (button) => {
                button.disabled =
                  true;
              }
            );


            message.textContent =
              "Registrando sua avaliação...";


            /*
             * Verifica se já existe avaliação.
             */

            const {
              data: existente,
              error: buscaError
            } =
              await supabase
                .from("avaliacoes")
                .select("id")
                .eq(
                  "user_id",
                  user.id
                )
                .eq(
                  "conteudo_tipo",
                  conteudoTipo
                )
                .eq(
                  "conteudo_id",
                  conteudoId
                )
                .maybeSingle();


            if (buscaError) {

              console.error(
                "Erro ao verificar avaliação:",
                buscaError
              );


              message.textContent =
                "Não foi possível verificar sua avaliação.";


              stars.forEach(
                (button) => {
                  button.disabled =
                    false;
                }
              );


              return;

            }


            let error;


            /*
             * Se já existe:
             * atualiza a nota.
             */

            if (existente) {

              const resultado =
                await supabase
                  .from("avaliacoes")
                  .update({
                    nota
                  })
                  .eq(
                    "id",
                    existente.id
                  )
                  .eq(
                    "user_id",
                    user.id
                  );


              error =
                resultado.error;

            }

            /*
             * Se não existe:
             * cria uma nova avaliação.
             */

            else {

              const resultado =
                await supabase
                  .from("avaliacoes")
                  .insert({
                    user_id:
                      user.id,

                    conteudo_tipo:
                      conteudoTipo,

                    conteudo_id:
                      conteudoId,

                    nota,

                    publicado:
                      false
                  });


              error =
                resultado.error;

            }


            /*
             * ERRO
             */

            if (error) {

              console.error(
                "Erro ao registrar avaliação:",
                error
              );


              message.textContent =
                `Erro ao registrar: ${error.message}`;


              stars.forEach(
                (button) => {
                  button.disabled =
                    false;
                }
              );


              return;

            }


            /*
             * SUCESSO
             */

            pintarEstrelas(
              nota
            );


            hint.textContent =
              "Você já avaliou este autor.";


            message.textContent =
              `Sua avaliação: ${nota}/5`;


            commentArea.hidden =
              false;


            const nome =
              user.user_metadata?.nome ||
              user.user_metadata?.full_name ||
              user.email ||
              "Avaliador";


            userName.textContent =
              `Avaliando como ${nome}`;


            avatar.textContent =
              nome
                .charAt(0)
                .toUpperCase();


            stars.forEach(
              (button) => {
                button.disabled =
                  false;
              }
            );


            /*
             * Atualiza a média imediatamente.
             */

            await carregarMediaComunidade();

          }
        );

      }
    );


    /*
     * CONTADOR DO COMENTÁRIO
     */

    commentInput.addEventListener(
      "input",
      () => {

        commentCounter.textContent =
          `${commentInput.value.length}/1000`;

      }
    );


    /*
     * PUBLICAR COMENTÁRIO
     */

    commentButton.addEventListener(
      "click",
      async () => {

        const {
          data: {
            user
          }
        } =
          await supabase.auth.getUser();


        if (!user) {

          return;

        }


        const comentario =
          commentInput.value.trim();


        if (!comentario) {

          message.textContent =
            "Escreva um comentário antes de publicar.";

          return;

        }


        commentButton.disabled =
          true;


        commentButton.textContent =
          "Publicando...";


        /*
         * Busca a avaliação do usuário.
         */

        const {
          data: avaliacao,
          error: buscaError
        } =
          await supabase
            .from("avaliacoes")
            .select("id")
            .eq(
              "user_id",
              user.id
            )
            .eq(
              "conteudo_tipo",
              conteudoTipo
            )
            .eq(
              "conteudo_id",
              conteudoId
            )
            .maybeSingle();


        if (
          buscaError ||
          !avaliacao
        ) {

          console.error(
            "Erro ao encontrar avaliação:",
            buscaError
          );


          message.textContent =
            "Faça sua avaliação antes de publicar um comentário.";


          commentButton.disabled =
            false;


          commentButton.textContent =
            "Publicar comentário";


          return;

        }


        /*
         * Salva o comentário.
         */

        const {
          error
        } =
          await supabase
            .from("avaliacoes")
            .update({
              comentario
            })
            .eq(
              "id",
              avaliacao.id
            )
            .eq(
              "user_id",
              user.id
            );


        if (error) {

          console.error(
            "Erro ao publicar comentário:",
            error
          );


          message.textContent =
            `Erro ao publicar: ${error.message}`;


          commentButton.disabled =
            false;


          commentButton.textContent =
            "Publicar comentário";


          return;

        }


        message.textContent =
          "Comentário salvo com sucesso.";


        commentButton.disabled =
          false;


        commentButton.textContent =
          "Atualizar comentário";

      }
    );

function montarResumoPublico() {

  if (
    !(publicSummary instanceof HTMLElement) ||
    !(contentSource instanceof HTMLElement)
  ) {
    return;
  }


  const elementos =
    Array.from(contentSource.children);


  let numeroSecao = 0;

  let capturando = false;


  elementos.forEach((elemento) => {

    const tag =
      elemento.tagName.toLowerCase();


    /*
     * Cada H2 inicia uma nova seção.
     */

    if (tag === "h2") {

      numeroSecao++;

      capturando =
        numeroSecao <= 2;

    }


    /*
     * Copia apenas as duas primeiras
     * seções para o resumo público.
     */

    if (capturando) {

      publicSummary.appendChild(
        elemento.cloneNode(true)
      );

    }

  });

}

    /*
 * INICIALIZAÇÃO
 */

carregarMediaComunidade();

carregarAvaliacao();

verificarNivelDoUsuario();

montarResumoPublico();

  </script>

</BaseLayout>


