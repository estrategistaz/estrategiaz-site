---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const autores = await getCollection("autores");

  return autores.map((autor) => ({
    params: {
      slug: autor.id
    },
    props: {
      autor
    }
  }));
}

const { autor } = Astro.props;

const score = autor.data.score ?? 0;

const aplicabilidade =
    autor.data.aplicabilidade ?? "Não avaliada";

const implementacao =
    autor.data.implementacao ?? "Não avaliada";

const { Content } = await render(autor);
---

<BaseLayout title={autor.data.title}>

<section class="container autor-page">

  <div class="autor-header">

    <div>
      <h1>{autor.data.title}</h1>

      <div class="autor-info">

        {autor.data.pais && (
          <p>
            <strong>País:</strong> {autor.data.pais}
          </p>
        )}

        {autor.data.nascimento && (
          <p>
            <strong>Nascimento:</strong> {autor.data.nascimento}
          </p>
        )}

        {autor.data.universidade && (
          <p>
            <strong>Universidade:</strong>

            {Array.isArray(autor.data.universidade)
              ? autor.data.universidade.join(" • ")
              : autor.data.universidade}
          </p>
        )}

      </div>
    </div>

    <div class="score-card">

      <span class="score-label">
        ESTRATEGIAZ SCORE
      </span>

      <div class="score">
        {score.toFixed(1)}
        <span>/10</span>
      </div>

      <div class="score-stars">
        ★★★★★
      </div>

      <p>
        Avaliação editorial EstrategiaZ
      </p>

    </div>

  </div>


  <div class="rating-grid">

    <div class="rating-item">
      <span>Aplicabilidade</span>
      <strong>{aplicabilidade}</strong>
    </div>

    <div class="rating-item">
      <span>Implementação</span>
      <strong>{implementacao}</strong>
    </div>

  </div>


  <article class="autor-content">

    <Content />

  </article>

</section>

</BaseLayout>


<style>

.autor-page {
  padding: 70px 0 100px;
}

.autor-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 40px;
  margin-bottom: 30px;
}

.autor-header h1 {
  font-size: 48px;
  margin: 0 0 25px;
  color: #102a43;
}

.autor-info p {
  margin: 8px 0;
  font-size: 17px;
}

.score-card {
  min-width: 220px;
  padding: 25px;
  border-radius: 16px;
  background: white;
  border: 1px solid #e1e7ef;
  box-shadow: 0 8px 25px rgba(0,0,0,0.06);
  text-align: center;
}

.score-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #64748b;
}

.score {
  margin-top: 8px;
  font-size: 52px;
  font-weight: 800;
  color: #2563eb;
}

.score span {
  font-size: 18px;
  color: #64748b;
}

.score-stars {
  color: #f59e0b;
  font-size: 20px;
  letter-spacing: 2px;
}

.score-card p {
  margin: 8px 0 0;
  font-size: 13px;
  color: #64748b;
}

.rating-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin: 25px 0 50px;
}

.rating-item {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 18px 22px;
}

.rating-item span {
  display: block;
  font-size: 13px;
  color: #64748b;
  margin-bottom: 6px;
}

.rating-item strong {
  font-size: 18px;
  color: #102a43;
}

.autor-content {
  max-width: 900px;
}

.autor-content h1 {
  display: none;
}

.autor-content h2 {
  margin-top: 45px;
  margin-bottom: 15px;
  font-size: 28px;
  color: #102a43;
}

.autor-content p,
.autor-content li {
  font-size: 17px;
  line-height: 1.7;
}

@media (max-width: 700px) {

  .autor-header {
    flex-direction: column;
  }

  .score-card {
    width: 100%;
  }

  .rating-grid {
    grid-template-columns: 1fr;
  }

  .autor-header h1 {
    font-size: 38px;
  }

}

</style>