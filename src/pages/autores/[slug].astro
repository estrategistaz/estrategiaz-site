  border-radius: 50%;
  background: #eaf1ff;
  color: #2563eb;
  font-size: 16px;
  font-weight: 750;
}

.review-user-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.review-user-info strong {
  color: #102a43;
  font-size: 14px;
  line-height: 1.3;
}

.review-user-info span {
  color: #64748b;
  font-size: 12px;
  line-height: 1.4;
}


/* =========================================
   CAMPO DE TEXTO
   ========================================= */

.comment-area label {
  display: block;
  margin-bottom: 8px;
  color: #102a43;
  font-size: 14px;
  font-weight: 650;
}

.comment-area textarea {
  display: block;
  width: 100%;
  min-height: 120px;
  box-sizing: border-box;
  resize: vertical;

  padding: 13px 14px;

  border: 1px solid #d8e0ea;
  border-radius: 12px;

  background: #f8fafc;
  color: #102a43;

  font-family: inherit;
  font-size: 14px;
  line-height: 1.55;

  outline: none;

  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.comment-area textarea::placeholder {
  color: #94a3b8;
}

.comment-area textarea:focus {
  border-color: #93b4f5;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
}


/* =========================================
   RODAPÉ DO COMENTÁRIO
   ========================================= */

.comment-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 10px;
}

#comment-counter {
  color: #94a3b8;
  font-size: 12px;
}

#comment-button {
  border: 0;
  border-radius: 10px;
  padding: 10px 16px;

  background: #2563eb;
  color: white;

  font-family: inherit;
  font-size: 13px;
  font-weight: 650;

  cursor: pointer;

  transition:
    background 0.18s ease,
    transform 0.15s ease,
    box-shadow 0.18s ease;
}

#comment-button:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
  box-shadow: 0 5px 14px rgba(37, 99, 235, 0.20);
}

#comment-button:disabled {
  opacity: 0.6;
  cursor: wait;
  transform: none;
}


/* =========================================
   RESPONSIVO
   ========================================= */

@media (max-width: 900px) {

  .community-rating {
    margin-top: 25px;
  }

}

@media (max-width: 700px) {

  .community-rating {
    padding: 22px;
    border-radius: 18px;
  }

  .community-rating h2 {
    font-size: 24px;
  }

  .rating-stars button {
    width: 34px;
    height: 34px;
    font-size: 27px;
  }

  .comment-footer {
    align-items: flex-start;
    flex-direction: column;
  } 

  #comment-button {
    width: 100%;
  }

}

</style>