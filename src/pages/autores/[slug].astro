---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const autores = await getCollection("autores");

  return autores.map((autor) => ({
    params: {
      slug: autor.id
    },
    props: {
      autor
    }
  }));
}

const { autor } = Astro.props;

const score = autor.data.score ?? 0;

const aplicabilidade =
  autor.data.aplicabilidade ?? "Não avaliada";

const implementacao =
  autor.data.implementacao ?? "Não avaliada";

const { Content } = await render(autor);

const autorSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": autor.data.title,
  "url": `https://estrategiaz.com/autores/${autor.id}`,
  ...(autor.data.pais && {
    "nationality": autor.data.pais
  }),
  ...(autor.data.nascimento && {
    "birthDate": `${autor.data.nascimento}-01-01`
  }),
  ...(autor.data.universidade && {
    "alumniOf": Array.isArray(autor.data.universidade)
      ? autor.data.universidade.map((universidade) => ({
          "@type": "CollegeOrUniversity",
          "name": universidade
        }))
      : {
          "@type": "CollegeOrUniversity",
          "name": autor.data.universidade
        }
  })
};

