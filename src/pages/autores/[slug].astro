---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const autores = await getCollection("autores");

  return autores.map((autor) => ({
    params: {
      slug: autor.id
    },
    props: {
      autor
    }
  }));
}

const { autor } = Astro.props;

const score = autor.data.score ?? 0;

const aplicabilidade =
  autor.data.aplicabilidade ?? "Não avaliada";

const implementacao =
  autor.data.implementacao ?? "Não avaliada";

const { Content } = await render(autor);
---

<BaseLayout
  title={autor.data.title}
  description={`Informações e avaliação de ${autor.data.title} no Estrategiaz.`}
>

  <section class="container autor-page">

    <div class="autor-header">

      <!-- INFORMAÇÕES DO AUTOR -->
      <div class="autor-main">

        <h1>{autor.data.title}</h1>

        <div class="autor-info">

          {autor.data.pais && (
            <p>
              <strong>País:</strong> {autor.data.pais}
            </p>
          )}

          {autor.data.nascimento && (
            <p>
              <strong>Nascimento:</strong> {autor.data.nascimento}
            </p>
          )}

          {autor.data.universidade && (
            <p>
              <strong>Universidade:</strong>{" "}

              {Array.isArray(autor.data.universidade)
                ? autor.data.universidade.join(" • ")
                : autor.data.universidade}
            </p>
          )}

        </div>

      </div>


      <!-- ESTRATEGIAZ SCORE -->
      <div class="score-card">

        <span class="score-label">
          ESTRATEGIAZ SCORE
        </span>

        <div class="score">
          {score.toFixed(1)}
          <span>/10</span>
        </div>

        <div class="score-stars">
          ★★★★★
        </div>

        <p>
          Avaliação editorial Estrategiaz
        </p>

      </div>


      <!-- AVALIAÇÃO DA COMUNIDADE -->
<section
  class="community-rating"
  id="rating-area"
>

  <div class="community-heading">

    <span class="community-eyebrow">
      AVALIAÇÃO DA COMUNIDADE
    </span>

    <h2>
      O que você acha deste autor?
    </h2>

    <p>
      Avalie o trabalho de {autor.data.title} e
      compartilhe sua experiência com outros profissionais.
    </p>

  </div>


  <div
    id="rating-stars"
    data-conteudo-id={autor.id}
    class="rating-stars"
  >

    <button
      type="button"
      data-rating="1"
      aria-label="Avaliar com 1 estrela"
    >
      ★
    </button>

    <button
      type="button"
      data-rating="2"
      aria-label="Avaliar com 2 estrelas"
    >
      ★
    </button>

    <button
      type="button"
      data-rating="3"
      aria-label="Avaliar com 3 estrelas"
    >
      ★
    </button>

    <button
      type="button"
      data-rating="4"
      aria-label="Avaliar com 4 estrelas"
    >
      ★
    </button>

    <button
      type="button"
      data-rating="5"
      aria-label="Avaliar com 5 estrelas"
    >
      ★
    </button>

  </div>


  <p
    id="rating-hint"
    class="rating-hint"
  >
    Selecione uma nota de 1 a 5.
  </p>


  <div
    id="rating-message"
    class="rating-message"
    aria-live="polite"
  ></div>


  <!-- ÁREA QUE APARECE DEPOIS DA AVALIAÇÃO -->

  <div
    id="comment-area"
    class="comment-area"
    hidden
  >

    <div class="review-user">

      <div
        class="review-avatar"
        id="review-avatar"
      >
        E
      </div>

      <div class="review-user-info">

        <strong id="review-user-name">
          Avaliando como você
        </strong>

        <span>
          Sua opinião ajuda a comunidade Estrategiaz.
        </span>

      </div>

    </div>


    <label for="comentario">
      Compartilhe sua opinião
    </label>


    <textarea
      id="comentario"
      maxlength="1000"
      placeholder="O que você acha do trabalho deste autor? Conte sua experiência, aplicação prática ou principal aprendizado..."
    ></textarea>


    <div class="comment-footer">

      <span id="comment-counter">
        0/1000
      </span>

      <button
        type="button"
        id="comment-button"
      >
        Publicar comentário
      </button>

    </div>

  </div>

</section>

    </div>


    <!-- AVALIAÇÕES EDITORIAIS -->
    <div class="rating-grid">

      <div class="rating-item">
        <span>Aplicabilidade</span>
        <strong>{aplicabilidade}</strong>
      </div>

      <div class="rating-item">
        <span>Implementação</span>
        <strong>{implementacao}</strong>
      </div>

    </div>


    <!-- CONTEÚDO DO AUTOR -->
    <article class="autor-content">

      <Content />

    </article>

  </section>


  <script>
  import { supabase } from "../../lib/supabase.js";

  const stars =
    document.querySelectorAll("#rating-stars button");

  const ratingContainer =
    document.querySelector("#rating-stars");

  const message =
    document.querySelector("#rating-message");

  const hint =
    document.querySelector("#rating-hint");

  const commentArea =
    document.querySelector("#comment-area");

  const commentInput =
    document.querySelector("#comentario");

  const commentButton =
    document.querySelector("#comment-button");

  const commentCounter =
    document.querySelector("#comment-counter");

  const userName =
    document.querySelector("#review-user-name");

  const avatar =
    document.querySelector("#review-avatar");

  if (
    !(ratingContainer instanceof HTMLElement) ||
    !(message instanceof HTMLElement) ||
    !(hint instanceof HTMLElement) ||
    !(commentArea instanceof HTMLElement) ||
    !(commentInput instanceof HTMLTextAreaElement) ||
    !(commentButton instanceof HTMLButtonElement) ||
    !(commentCounter instanceof HTMLElement) ||
    !(userName instanceof HTMLElement) ||
    !(avatar instanceof HTMLElement)
  ) {
    throw new Error(
      "Elementos da avaliação não encontrados."
    );
  }

  const conteudoTipo = "autor";

  const conteudoId =
    ratingContainer.dataset.conteudoId;

  if (!conteudoId) {
    throw new Error(
      "ID do autor não encontrado."
    );
  }

  function pintarEstrelas(nota) {

    stars.forEach((button) => {

      const valor =
        Number(button.getAttribute("data-rating"));

      button.classList.toggle(
        "selected",
        valor <= nota
      );

    });

  }

  async function carregarAvaliacao() {

    const {
      data: {
        user
      }
    } = await supabase.auth.getUser();

    if (!user) {
      return;
    }

    const {
      data: avaliacao,
      error
    } = await supabase
      .from("avaliacoes")
      .select("nota, comentario")
      .eq("user_id", user.id)
      .eq("conteudo_tipo", conteudoTipo)
      .eq("conteudo_id", conteudoId)
      .maybeSingle();

    if (error) {

      console.error(
        "Erro ao carregar avaliação:",
        error
      );

      return;
    }

    if (!avaliacao) {
      return;
    }

    pintarEstrelas(avaliacao.nota);

    hint.textContent =
      "Você já avaliou este autor.";

    message.textContent =
      `Sua avaliação: ${avaliacao.nota}/5`;

    commentArea.hidden = false;

    const nome =
      user.user_metadata?.nome ||
      user.user_metadata?.full_name ||
      user.email ||
      "Avaliador";

    userName.textContent =
      `Avaliando como ${nome}`;

    avatar.textContent =
      nome.charAt(0).toUpperCase();

    if (avaliacao.comentario) {

      commentInput.value =
        avaliacao.comentario;

      commentCounter.textContent =
        `${avaliacao.comentario.length}/1000`;

      commentButton.textContent =
        "Atualizar comentário";
    }

  }

  stars.forEach((star) => {

    star.addEventListener(
      "click",
      async () => {

        const nota =
          Number(
            star.getAttribute("data-rating")
          );

        const {
          data: {
            user
          }
        } = await supabase.auth.getUser();

        if (!user) {

          window.location.href =
            `/login?redirect=/autores/${conteudoId}`;

          return;
        }

        stars.forEach((button) => {
          button.disabled = true;
        });

        const {
          data: existente,
          error: buscaError
        } = await supabase
          .from("avaliacoes")
          .select("id")
          .eq("user_id", user.id)
          .eq("conteudo_tipo", conteudoTipo)
          .eq("conteudo_id", conteudoId)
          .maybeSingle();

        if (buscaError) {

          console.error(
            "Erro ao verificar avaliação:",
            buscaError
          );

          message.textContent =
            "Não foi possível verificar sua avaliação.";

          stars.forEach((button) => {
            button.disabled = false;
          });

          return;
        }

        let error;

        if (existente) {

          const resultado =
            await supabase
              .from("avaliacoes")
              .update({
                nota
              })
              .eq("id", existente.id)
              .eq("user_id", user.id);

          error = resultado.error;

        } else {

          const resultado =
            await supabase
              .from("avaliacoes")
              .insert({
                user_id: user.id,
                conteudo_tipo: conteudoTipo,
                conteudo_id: conteudoId,
                nota,
                publicado: false
              });

          error = resultado.error;

        }

        if (error) {

          console.error(
            "Erro ao registrar avaliação:",
            error
          );

          message.textContent =
            `Erro ao registrar: ${error.message}`;

          stars.forEach((button) => {
            button.disabled = false;
          });

          return;
        }

        pintarEstrelas(nota);

        hint.textContent =
          "Você já avaliou este autor.";

        message.textContent =
          `Sua avaliação: ${nota}/5`;

        commentArea.hidden = false;

        const nome =
          user.user_metadata?.nome ||
          user.user_metadata?.full_name ||
          user.email ||
          "Avaliador";

        userName.textContent =
          `Avaliando como ${nome}`;

        avatar.textContent =
          nome.charAt(0).toUpperCase();

        stars.forEach((button) => {
          button.disabled = false;
        });

      }
    );

  });

  commentInput.addEventListener(
    "input",
    () => {

      commentCounter.textContent =
        `${commentInput.value.length}/1000`;

    }
  );

  commentButton.addEventListener(
    "click",
    async () => {

      const {
        data: {
          user
        }
      } = await supabase.auth.getUser();

      if (!user) {
        return;
      }

      const comentario =
        commentInput.value.trim();

      if (!comentario) {

        message.textContent =
          "Escreva um comentário antes de publicar.";

        return;
      }

      commentButton.disabled = true;

      commentButton.textContent =
        "Publicando...";

      const {
        data: avaliacao,
        error: buscaError
      } = await supabase
        .from("avaliacoes")
        .select("id")
        .eq("user_id", user.id)
        .eq("conteudo_tipo", conteudoTipo)
        .eq("conteudo_id", conteudoId)
        .maybeSingle();

      if (buscaError || !avaliacao) {

        console.error(
          "Erro ao encontrar avaliação:",
          buscaError
        );

        message.textContent =
          "Faça sua avaliação antes de publicar um comentário.";

        commentButton.disabled = false;
        commentButton.textContent =
          "Publicar comentário";

        return;
      }

      const {
        error
      } = await supabase
        .from("avaliacoes")
        .update({
          comentario
        })
        .eq("id", avaliacao.id)
        .eq("user_id", user.id);

      if (error) {

        console.error(
          "Erro ao publicar comentário:",
          error
        );

        message.textContent =
          `Erro ao publicar: ${error.message}`;

        commentButton.disabled = false;
        commentButton.textContent =
          "Publicar comentário";

        return;
      }

      message.textContent =
        "Comentário salvo com sucesso.";

      commentButton.disabled = false;

      commentButton.textContent =
        "Atualizar comentário";

    }
  );

  carregarAvaliacao();
</script>
</BaseLayout>


<style>

.autor-page {
  padding: 70px 0 100px;
}


.autor-header {
  display: grid;
  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(220px, 280px)
    minmax(320px, 1fr);

  align-items: start;
  gap: 40px;

  margin-bottom: 35px;
}


.autor-main h1 {
  font-size: 48px;
  line-height: 1.1;

  margin: 0 0 25px;

  color: #102a43;
}


.autor-info p {
  margin: 8px 0;

  font-size: 17px;

  line-height: 1.6;
}


.score-card {
  padding: 25px;

  border-radius: 16px;

  background: white;

  border: 1px solid #e1e7ef;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.06);

  text-align: center;
}


.score-label {
  display: block;

  font-size: 12px;

  font-weight: 700;

  letter-spacing: 1.5px;

  color: #64748b;
}


.score {
  margin-top: 8px;

  font-size: 52px;

  font-weight: 800;

  color: #2563eb;
}


.score span {
  font-size: 18px;

  color: #64748b;
}


.score-stars {
  color: #f59e0b;

  font-size: 20px;

  letter-spacing: 2px;
}


.score-card p {
  margin: 8px 0 0;

  font-size: 13px;

  color: #64748b;

  line-height: 1.5;
}


/* COMUNIDADE */

.community-rating {
  padding: 28px;

  background: white;

  border:
    1px solid #e1e7ef;

  border-radius: 16px;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.04);
}


.community-rating h2 {
  margin: 0 0 14px;

  font-size: 27px;

  color: #102a43;
}


.community-rating > p {
  margin: 0 0 20px;

  line-height: 1.6;

  color: #334e68;
}


/* ESTRELAS */

#rating-stars {
  display: flex;

  gap: 4px;

  margin-top: 10px;
}


#rating-stars button {
  border: none;

  background: transparent;

  padding: 0;

  font-size: 30px;

  line-height: 1;

  color: #cbd5e1;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    color 0.15s ease;
}


#rating-stars button:hover {
  color: #f59e0b;

  transform: translateY(-2px);
}


#rating-stars button.selected {
  color: #f59e0b;
}


#rating-stars button:disabled {
  cursor: default;
}


#rating-stars button:disabled:hover {
  transform: none;
}


/* TEXTOS DA AVALIAÇÃO */

.rating-instruction {
  margin-top: 12px !important;

  margin-bottom: 4px !important;

  font-size: 13px;

  color: #64748b;
}


.rating-message {
  min-height: 22px;

  margin-top: 6px !important;

  font-size: 14px;

  font-weight: 600;

  color: #2563eb;
}


/* GRID EDITORIAL */

.rating-grid {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 20px;

  margin: 25px 0 50px;
}


.rating-item {
  background: #f8fafc;

  border:
    1px solid #e2e8f0;

  border-radius: 12px;

  padding: 18px 22px;
}


.rating-item span {
  display: block;

  font-size: 13px;

  color: #64748b;

  margin-bottom: 6px;
}


.rating-item strong {
  font-size: 18px;

  color: #102a43;
}


/* CONTEÚDO */

.autor-content {
  max-width: 900px;
}


.autor-content h1 {
  display: none;
}


.autor-content h2 {
  margin-top: 45px;

  margin-bottom: 15px;

  font-size: 28px;

  color: #102a43;
}


.autor-content p,
.autor-content li {
  font-size: 17px;

  line-height: 1.7;
}


/* RESPONSIVO */

@media (max-width: 1000px) {

  .autor-header {
    grid-template-columns: 1fr 1fr;
  }

  .autor-main {
    grid-column: 1 / -1;
  }

  .community-rating {
    grid-column: 1 / -1;
  }

}


@media (max-width: 700px) {

  .autor-page {
    padding:
      40px 0 70px;
  }


  .autor-header {
    display: flex;

    flex-direction: column;

    gap: 25px;
  }


  .autor-main,
  .score-card,
  .community-rating {
    width: 100%;
  }


  .score-card {
    box-sizing: border-box;
  }


  .rating-grid {
    grid-template-columns: 1fr;
  }


  .autor-main h1 {
    font-size: 38px;
  }

}
/* =========================================
   AVALIAÇÃO DA COMUNIDADE
   ========================================= */

.community-rating {
  width: 100%;
  box-sizing: border-box;
  margin-top: 0;
  padding: 30px;
  border: 1px solid #e2e8f0;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
}

.community-heading {
  margin-bottom: 22px;
}

.community-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.6px;
  text-transform: uppercase;
}

.community-rating h2 {
  margin: 0 0 12px;
  color: #102a43;
  font-size: 28px;
  line-height: 1.2;
  font-weight: 750;
}

.community-rating p {
  margin: 0;
  color: #475569;
  font-size: 15px;
  line-height: 1.65;
}


/* =========================================
   ESTRELAS
   ========================================= */

.rating-stars {
  display: flex;
  align-items: center;
  gap: 5px;
  margin: 22px 0 8px;
}

.rating-stars button {
  width: 38px;
  height: 38px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #cbd5e1;
  font-size: 29px;
  line-height: 1;
  cursor: pointer;
  transition:
    transform 0.15s ease,
    color 0.15s ease;
}

.rating-stars button:hover {
  color: #f59e0b;
  transform: translateY(-2px) scale(1.08);
}

.rating-stars button.selected {
  color: #f59e0b;
}

.rating-stars button:disabled {
  cursor: default;
}

.rating-stars button:disabled:hover {
  transform: none;
}


/* =========================================
   MENSAGENS
   ========================================= */

.rating-hint {
  margin-top: 4px !important;
  color: #64748b !important;
  font-size: 13px !important;
}

.rating-message {
  min-height: 22px;
  margin-top: 8px;
  color: #2563eb;
  font-size: 14px;
  font-weight: 600;
}


/* =========================================
   ÁREA DO COMENTÁRIO
   ========================================= */

.comment-area {
  margin-top: 24px;
  padding-top: 22px;
  border-top: 1px solid #e2e8f0;
}

.comment-area[hidden] {
  display: none;
}

.review-user {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.review-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40px;
  width: 40px;
