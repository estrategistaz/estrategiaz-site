---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout
    title="EstrategiaZ"
    description="Consultoria estratégica para empresas">


    <main class="hero container">

    <div class="hero-content">

        <span class="tag">
            Plataforma de Estratégia Empresarial
        </span>

        <h1>Conhecimento estratégico organizado para quem decide.</h1>

<p>
Autores, livros e frameworks reunidos em uma única plataforma.
</p>

        <div class="buttons">

            <a class="primary" href="#">
                Explorar Conteúdo
            </a>

            <a class="secondary" href="#">
                Conhecer o Projeto
            </a>

        </div>

    </div>

</main>
<section class="categorias container">

    <h2>Nossa Biblioteca Estratégica</h2>

<div class="grid">

<a class="card" href="/autores">
    <span>👤</span>
    <h3>Autores</h3>
    <p>
        Os maiores pensadores da estratégia, administração,
        inovação e liderança.
    </p>
</a>

<a class="card" href="/livros">
    <span>📚</span>
    <h3>Livros</h3>
    <p>
        As obras fundamentais que moldaram a gestão,
        a competitividade e a estratégia empresarial.
    </p>
</a>

<a class="card" href="/frameworks">
    <span>📈</span>
    <h3>Frameworks</h3>
    <p>
        Ferramentas, modelos e métodos utilizados por empresas
        e consultores no mundo inteiro.
    </p>
</a>

</div>

</section>
<style>

.hero{

    min-height:75vh;

    display:flex;

    align-items:center;

}

.hero-content{

    max-width:720px;

}

.tag{

    display:inline-block;

    padding:8px 18px;

    background:#dbeafe;

    color:#2563eb;

    border-radius:999px;

    font-weight:600;

    margin-bottom:20px;

}

.hero h1{

    font-size:4rem;

    line-height:1.1;

    margin-bottom:24px;

}

.hero p{

    font-size:1.25rem;

    color:#475569;

    margin-bottom:40px;

}

.buttons{

    display:flex;

    gap:20px;

}

.primary{

    background:#2563eb;

    color:white;

    padding:16px 28px;

    border-radius:12px;

    font-weight:600;

}

.secondary{

    border:2px solid #2563eb;

    color:#2563eb;

    padding:16px 28px;

    border-radius:12px;

    font-weight:600;

}

.primary:hover{

    background:#1d4ed8;

}

.secondary:hover{

    background:#eff6ff;

}
.categorias{

    padding:90px 0;

}

.categorias h2{

    text-align:center;

    margin-bottom:50px;

    font-size:2.3rem;

}

.grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:28px;

    width:100%;

}

.card{

    background:white;

    border-radius:18px;

    padding:35px;

    box-shadow:0 8px 20px rgba(0,0,0,.06);

    transition:.25s;

}

.card:hover{

    transform:translateY(-8px);

    box-shadow:0 18px 40px rgba(0,0,0,.10);

}

.card span{

    font-size:2rem;

}

.card h3{

    margin:20px 0 12px;

}

.card p{

    color:#64748b;

}
/* ===========================
   MOBILE
=========================== */

@media (max-width:768px){

    .hero{

        min-height:auto;
        padding:40px 0;

    }

    .hero-content{

        width:100%;
        padding:0 8px;

    }

    .hero h1{

        font-size:2.2rem;
        line-height:1.2;
        margin-bottom:20px;

    }

    .hero p{

        font-size:1rem;
        margin-bottom:30px;

    }

    .buttons{

        display:flex;
        flex-direction:column;
        gap:16px;
        width:100%;

    }

    .primary,
    .secondary{

        display:block;
        width:100%;
        text-align:center;
        padding:16px;

    }

    .categorias{

        padding:60px 0;

    }

    .grid{

        grid-template-columns:1fr;
        gap:20px;

    }

    .card{

        padding:24px;

    }

}   
</style>

</BaseLayout>