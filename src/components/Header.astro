<header class="header">

    <div class="container nav">

        <a href="/" class="logo">
            Estrategia<span>Z</span>
        </a>
<button class="menu-toggle" id="menu-toggle">
    ☰
</button>


        <nav class="menu" id="menu">

            <a href="/">Início</a>

            <a href="/biblioteca">Biblioteca</a>

            <a href="/consultoria">Consultoria</a>

            <a href="/artigos">Artigos</a>

        </nav>

    </div>

</header>

<style>

.header{

    background:white;
    border-bottom:1px solid #e5e7eb;
    position:sticky;
    top:0;
    z-index:100;

}

.nav{

    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 0;

}

.logo{

    font-size:1.8rem;
    font-weight:700;
    text-decoration:none;
    color:#0f172a;

}

.logo span{

    color:#2563eb;

}

.menu{

    display:flex;
    gap:35px;

}

.menu a{

    text-decoration:none;
    color:#475569;
    font-weight:500;
    transition:.25s;

}

.menu a:hover{

    color:#2563eb;

}

.menu-toggle{

    display:none;

    background:none;

    border:none;

    cursor:pointer;

    font-size:2rem;

    color:#0f172a;

    padding:8px;

    line-height:1;

}
/* =======================
   TABLET
======================= */

@media (max-width:900px){

    .menu{

        gap:20px;

    }

}

/* =======================
   CELULAR
======================= */

@media (max-width:600px){

    .nav{

        flex-direction:row;

        justify-content:space-between;

        align-items:center;

    }

    .logo{

        font-size:2rem;

    }

    .menu{

    display:none;

    position:absolute;

    top:75px;

    left:0;

    width:100%;

    background:white;

    flex-direction:column;

    padding:20px;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}
.menu.active{

    display:flex;

}

    .menu-toggle{

        display:block;

    }

}

</style>
<script>

document.addEventListener("DOMContentLoaded", () => {

    const botao = document.getElementById("menu-toggle");
    const menu = document.getElementById("menu");

    if (botao && menu) {

        botao.addEventListener("click", () => {

            menu.classList.toggle("active");

        });

    }

});

</script>